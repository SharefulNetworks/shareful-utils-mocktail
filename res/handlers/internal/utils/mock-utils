#!/usr/bin/bash


# A collection of helper functions to simplify the process of working with 
# Mock API collections and their constituent endpoints, including the ability 
# to load and parse Mock API collections from JSON files, map request paths to 
# specific Mock API endpoints, and facilitate GET and POST request/response cycles 
# to those endpoints.

#Reads a Mock API collection from a JSON file and returns the parsed JSON object.
ReadMockAPICollection() {
    path="$1"
    jq -r '.' "$path"
}

# stores the provided mocK API collection JSON to the provided file path, overwriting any existing file at that path.
StoreMockAPICollection() {
    local json="$1"
    local path="$2"
    echo "$json" | jq -r '.' > "$path"
}

# deletes the Mock API collection file at the provided path from the host file system, if it exists.
DeleteMockAPICollection() {
    local path="$1"
    rm -f "$path"
}


# reads a specific value from the JSON Mock API collection using jq a reference
# to the Mock API Collection JSON must be provided as the first argument, and the key to read 
# must be provided as the second argument.
ParseMockAPICollectionField() {
    local json="$1"
    local path="$2"
    jq -cr "$path" <<< "$json"
}

ParseMockAPICollectionEndpoints() {
    local json="$1"
    jq -cr '.Endpoints // .endpoints // []' <<< "$json"
}

ParseMockAPICollectionEndpointField() {
    local endpointJson="$1"
    local path="$2"
    jq -cr "$path" <<< "$endpointJson"
}

ParseMockAPICollectionEndpointResponseHeaders() {
    local endpointJson="$1"
    jq -r '.Response.Headers // {} | to_entries[]? | "\(.key)\t\(.value)"' <<< "$endpointJson"
}

ParseMockAPICollectionEndpointResponseBody(){
    local endpointJson="$1"
    jq -r '
        if (.Response.Body // null) == null then ""
        elif (.Response.Body | type) == "string" then .Response.Body
        else (.Response.Body | tojson)
        end
    ' <<< "$endpointJson"
}

EndpointExistsInMockAPICollection() {
    local mockCollectionJson="$1"
    local requestPath="$2"
    local requestMethod="$3"

    local endpoint
    endpoint=$(ResolveMockEndpoint "$mockCollectionJson" "$requestPath" "$requestMethod")

    if [[ -n "$endpoint" ]]; then
        return 0  # Endpoint exists
    else
        return 1  # Endpoint does not exist
    fi
}



SetMockAPICollectionField() {
    local json="$1"
    local path="$2"
    local value="$3"
    jq -cr --arg path "$path" --arg value "$value" 'setpath($path[1:] | split("." ); $value)' <<< "$json"
}


# indicates if the provided JSON is an array, returning true if it is and false if it is not.
IsAnArray() {
    local json="$1"
    jq -e 'if type == "array" then true else false end' <<< "$json" > /dev/null
}

IsAnObject() {
    local json="$1"
    jq -e 'if type == "object" then true else false end' <<< "$json" > /dev/null
}

GetJsonType() {
    local json="$1"
    jq -r 'type' <<< "$json"
}

ArrayLength() {
    local json="$1"
    jq -r 'length' <<< "$json"
}

GetMockAPICollectionIndexById() {
    local mockAPICollectionsMetaData="$1"
    local collectionId="$2"

    jq -r --arg collectionId "$collectionId" '
        to_entries
        | map(select(.value.CollectionId == $collectionId))
        | .[0].key // -1
    ' <<< "$mockAPICollectionsMetaData"
}

GetMockAPICollectionEndpintCount(){
    local mockCollectionJson="$1"
    jq -r '(.Endpoints // .endpoints // []) | length' <<< "$mockCollectionJson"
}

GetMockAPICollectionEndpointById() {
    local mockCollectionJson="$1"
    local endpointId="$2"

    jq -c --arg endpointId "$endpointId" '
        (.Endpoints // .endpoints // [])
        | map(select((.Id | tostring) == $endpointId))
        | .[0] // empty
    ' <<< "$mockCollectionJson"
}

UpdateMockAPICollectionEndpointById(){
    local mockCollectionJson="$1"
    local endpointId="$2"
    local updatedEndpointJson="$3"

    jq -c --arg endpointId "$endpointId" --argjson updatedEndpoint "$updatedEndpointJson" '
        (.Endpoints // .endpoints) |= map(
            if (.Id | tostring) == $endpointId then $updatedEndpoint else . end
        )
    ' <<< "$mockCollectionJson"
}

RemoveMockAPICollectionEndpointById(){
    local mockCollectionJson="$1"
    local endpointId="$2"

    jq -c --arg endpointId "$endpointId" '
        (.Endpoints // .endpoints) |= map(
            select((.Id | tostring) != $endpointId)
        )
    ' <<< "$mockCollectionJson"
}   

JsonArrayToLines() {
  local jsonStr="$1"
  jq -r '.[]' <<< "$jsonStr"
}

# Resolves a single endpoint definition from a mock API collection for the supplied path and method.
# Matching precedence is:
# 1) exact static path match (e.g. /api/v1/users/settings)
# 2) parameterized path match (e.g. /api/v1/users/{userId})
ResolveMockEndpoint(){
    local mockCollectionJson="$1"
    local requestPath="$2"
    local requestMethod="$3"

    jq -c \
        --arg requestPath "$requestPath" \
        --arg requestMethod "$requestMethod" '
        def normPath:
            tostring
            | if . == "" then "/" else . end
            | if startswith("/") then . else "/" + . end
            | if . == "/" then . else sub("/+$"; "") end;

        def pathSegments:
            normPath
            | if . == "/" then [] else ltrimstr("/") | split("/") end;

        def isParamSegment:
            test("^\\{[^/]+\\}$");

                def matchesTemplate($path; $templatePath):
                        ($templatePath | pathSegments) as $templateSegments
            | ($path | pathSegments) as $requestSegments
            | ($templateSegments | length) == ($requestSegments | length)
              and all(range(0; ($templateSegments | length));
                ($templateSegments[.] | isParamSegment) or ($templateSegments[.] == $requestSegments[.])
              );

        (.Endpoints // .endpoints // []) as $endpoints
        | ($requestPath | normPath) as $path
        | ($requestMethod | ascii_downcase) as $method
        | [
            $endpoints[]
            | .Path as $rawPath
            | (.Method // .method // "") as $endpointMethod
            | ($rawPath | normPath) as $normalizedPath
            | select(($endpointMethod == "") or (($endpointMethod | ascii_downcase) == $method))
            | . + {
                __normalizedPath: $normalizedPath,
                                __isParamPath: ($normalizedPath | pathSegments | any(.[]; isParamSegment)),
                                __segmentCount: ($normalizedPath | pathSegments | length),
                                __paramCount: ($normalizedPath | pathSegments | map(select(isParamSegment)) | length)
              }
          ] as $candidates
        | (
            ([ $candidates[] | select((.__isParamPath | not) and (.__normalizedPath == $path)) ] | .[0])
            //
            ([
                $candidates[]
                | select(.__isParamPath)
                                | select(. as $candidate | matchesTemplate($path; $candidate.__normalizedPath))
              ]
                         | max_by([.__segmentCount, (-(.__paramCount))]))
          ) // empty
        ' <<< "$mockCollectionJson"
}



GetMockAPIEndpointStatsById() {
    local endpointStatsArr="$1"
    local endpointId="$2"

    jq -c --arg endpointId "$endpointId" '
        map(select(.EndpointId == $endpointId))
        | .[0] // empty
    ' <<< "$endpointStatsArr"
}


UpdateMockAPIEndpointStatsById(){
    local endpointStatsArr="$1"
    local endpointId="$2"
    local updatedEndpointStatsJson="$3"

    jq -c --arg endpointId "$endpointId" --argjson updatedEndpointStats "$updatedEndpointStatsJson" '
        map(
            if .EndpointId == $endpointId then $updatedEndpointStats else . end
        )
    ' <<< "$endpointStatsArr"
}


SelectTopTenEndpoints(){
    local endpointStatsArr="$1"

    jq -c '
        sort_by(.Count) | reverse | .[0:10]
    ' <<< "$endpointStatsArr"
}

   
