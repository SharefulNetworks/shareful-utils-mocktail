#!/bin/bash


#A suite of handler utility functions, used by all handler scripts, to perform common tasks 
# such as request parsing, route resolution and response generation/return.

# log messsag to indicate that the script has been successfully loaded/sourced
echo "handler-utils: Loaded handler utility functions." >&2

# import/source the mime type utility functions, which are used by the static route handling logic to determine the correct content type to return for static resources.
source "$(dirname "${BASH_SOURCE[0]}")/mime-utils" #we use path relative to this script, the utilities both share the same parent "utils" directory.


# read and parse the request read from the socket into an array of headers and a body, taking care to handle the case where the 
# request may not have a body, and return the headers and body as separate variables.
readAndParseRequest(){ 

  local method path protocol
  local header
  local content_length=0
  local headers='{}'
  local body=''
  local query_raw
  local query_json='{}'

  read -r -t 5 method path protocol || return 1

  # Extract the query string from the path (safe split)
  if [[ "$path" == *\?* ]]; then
    query_raw="${path#*\?}"
    path="${path%%\?*}"
  else
    query_raw=""
  fi

  echo "handler-utils: Received request>>>>: $method $path $protocol " >&2
  #echo "QUERY STRING IS: $query_string" >&2

  # parse headers into json objects of key value pairs, taking care to handle the case where the request may not have any headers, and return the headers as a json object.
  while IFS= read -r header; do
  
      header=${header%$'\r'} 
      [[ -z "$header" ]] && break 
      local name=${header%%:*}
      local value=${header#*: }
      
      headers=$(
          jq \
              --arg name "$name" \
              --arg value "$value" \
              '. + {($name): $value}' \
              <<< "$headers"
      ) 
      [[ $name == "Content-Length" ]] &&
          content_length=$value
  done

  if (( content_length > 0 )); then
      IFS= read -r -N "$content_length" body
  fi

  
  # similarly parse query string into json objects of key value pairs, taking care to handle the case where the request may not have any query parameters, and return the query string as a json object.
    if [[ -n "$query_raw" ]]; then
      IFS='&' read -ra query_params <<< "$query_raw"
      for param in "${query_params[@]}"; do
        local name=${param%%=*}
        local value=${param#*=}
        query_json=$(
          jq \
            --arg name "$name" \
            --arg value "$value" \
            '. + {($name): $value}' \
            <<< "$query_json"
        )
      done
    fi

  jq -n \
      --arg method "$method" \
      --arg path "$path" \
      --arg protocol "$protocol" \
        --arg body "$body" \
        --argjson headers "$headers" \
        --argjson query_string "$query_json" \
      '{
          method: $method,
          path: $path,
          protocol: $protocol,
          headers: $headers,
          query_string: $query_string,
          body: $body
      }'

}

 

# attempts to resolve the defined route associated with the specified path 
resolveRouteFromPath() {

 local path="$1"
 local config_path="$2"
 local route_info

 echo "handler-utils: Resolving route for path: $path using configuration standby..." >&2

 # Use jq to select the longest matching wildcard route, then extract the
 # route type and handler script for sub-handler routes.
 route_info="$({
    jq -c --arg path "$path" '
      [.Routes[]
       | .Path as $route_path
       | select(
           ($route_path | rtrimstr("*") | rtrimstr("/")) as $prefix
           | (
               ($path == $prefix)
               or ($path | startswith($prefix + "/"))
               or ($path | startswith($prefix + "?"))
             )
         )
      ]
      | sort_by(.Path | length)
      | reverse
      | .[0] // empty
    ' "${config_path}"
  })"

 # where we have found a matching route return it.
 if [[ -n "$route_info" ]]; then
     echo "handler-utils: Successfully resolved route for path: $path" >&2
     echo "$route_info"
  else
        echo "handler-utils: No matching route found for path: $path" >&2
        echo "" # return empty string to indicate no route found 
 fi
   

}

# handles the request according to the route Type defined in the route data provided as the first 
# parameter to this function. Where the specified route type is unsupported an appropriate error
# response will be generated and returned to the client.
handleRequestAccordingToRoute() {
  echo "handler-utils: Handling request for path: $path according to resolved route..." >&2
  local route_info="$1"
  local path="$2"
  local method="$3"
  local protocol="$4"

  #parse the route type from the route info, then handle request according to it.
  route_type=$(parseRouteType "$route_info")
  case "$route_type" in
    "sub-handler")
        handleSubHandlerRouteRequest "$route_info" "$path" "$method" "$protocol"
        ;;
    "static")
        handleStaticRouteRequest "$route_info" "$path" "$method" "$protocol"
        ;;
    "json-response")
        handleJsonResponseRouteRequest "$route_info"
        ;;
    *)
        echo "root-handler: Unsupported route type: $route_type for path: $path, sending error response." >&2
        dispatchErrorResponse 1 "$path" "$method" "$protocol"
        echo "root-handler: Default response sent for path: $path, closing connection." >&2
        ;;
  esac

}

# handles SubHandler type route requests by delgating to the specified sub-handler script defined in the route info, 
# where the route type is unsupported or no valid script is provided an appropriate error response will be generated 
# and returned to the client.
handleSubHandlerRouteRequest() {
  echo "handler-utils: Handling request for path: $path according to SubHandler route type..." >&2
  local route_info="$1"
  local request_path="$2"
  local request_method="$3"
  local request_protocol="$4"

  local route_type=$(parseRouteType "$route_info")
  local route_path=$(parseRoutePath "$route_info")
  local route_sub_handler_script="$(parseSubHandlerRouteScript "$route_info")"

  # ensure the route type is of type sub handler and a sub handler script path has been specified.
  if [[ "$route_type" == "sub-handler" && -n "$route_sub_handler_script" ]]; then
    route_sub_handler_script="${route_sub_handler_script#/}"  # parse the relative sub-handler script path from the config, ensuring we remove any leading slash to avoid issues when constructing the full path.
    route_sub_handler_script="${SCRIPT_DIR}/${route_sub_handler_script}" # construct the full path to the sub-handler script by combining the basescript directory path with the relative path from the config.
    echo "root-handler: Routing to sub-handler script: $route_sub_handler_script for path: $request_path" >&2
    
    # before delegating to the sub-handler script we need to strip the matched prefix from the path, this is because the sub-handlers will 
    # expect paths to be relative to their own defined route path, for example if we have a route with the path "/usr" and a request comes in 
    # for "/usr/profile", when we delegate to the sub-handler we want to pass it "profile" as the path rather than "/usr/profile", 
    # this allows the sub-handler to be more flexible and reusable as it can be mounted at different base paths without needing to 
    # worry about adjusting the paths it receives.
    local stripped_request_path=$(stripPrefixFromPath "$request_path" "$route_path")
    "$route_sub_handler_script" "$request_path" "$request_method" "$request_protocol" "/$stripped_request_path"
    return $?
  else
    echo "handler-utils: Unsupported route type: $route_type or script definition for SubHandler route type associated with path: $request_path, sending default response." >&2
    dispatchErrorResponse 1 "$request_path" "$request_method" "$request_protocol"
  fi
}



# handles Static type route requests by reading the specified static resource from the file system and 
#returning its contents in the response body, where the route type is unsupported or no valid file path is provided 
#an appropriate error response will be generated and returned to the client.
handleStaticRouteRequest() {
  echo "handler-utils: Handling request for path: $path according to Static route type..." >&2

  # for static routes we will have a path to a static resource i.e. file, defined in the config
  # we parse those details here then attempt to read the file into memory and return its contents
  # in the response body, we also set the content type based on the file extension, defaulting to 
  # application/json if we cannot determine a specific type.
  local route_info="$1"
  local request_path="$2"
  local request_method="$3"
  local request_protocol="$4"


  local route_path=$(parseRoutePath "$route_info")
  local route_type=$(parseRouteType "$route_info")
  local route_file_path="$(parseStaticRouteFilePath "$route_info")"
  if [[ "$route_type" == "static" && -n "$route_file_path" ]]; then 
    
    # what we do next will depend on whether this is a wildcard static route or not as denoted
    # by a route Path that is suffixed with a wildcard i.e "*" character
    absolute_file_path=""
    if [[ "$route_path" == *"*" ]]; then
     
        echo "handler-utils: Handling request for wildcard static route, stripping wildcard character AND trailing slash (if it exists) from route path..." >&2
        
        # we need to strip the wildcard character from the end of the route path, we also want to ensure we strip any trailing slash that may be left after removing 
        # the wildcard character as this will interfere with our path resolution logic later on.
        route_path="${route_path%\*}" 
        route_path="${route_path%/}"

        # build up the absolute file path by stripping the route prefix from the
        # request path and joining that remainder with the configured FilePath.
        # e.g. route Path: /assets/*, request_path: /assets/modules/x.css
        # remainder => modules/x.css, final => [SCRIPT_DIR]/[FilePath]/modules/x.css
        local stripped_request_path
        stripped_request_path=$(stripPrefixFromPath "$request_path" "$route_path")
        if command -v realpath >/dev/null 2>&1; then
          # Use realpath -m to normalize duplicate slashes and path segments
          absolute_file_path=$(realpath -m "${SCRIPT_DIR}/${route_file_path#/}/${stripped_request_path#/}")
        else
          # Fallback: manually strip trailing slash from base and join
          base="${route_file_path#/}"
          base="${base%/}"
          if [[ -n "$stripped_request_path" ]]; then
            absolute_file_path="${SCRIPT_DIR}/${base}/${stripped_request_path#/}"
          else
            absolute_file_path="${SCRIPT_DIR}/${base}"
          fi
        fi
        echo "handler-utils: final file path for static (wildcard) route is: $absolute_file_path" >&2

    else
      echo "handler-utils: Handling request for non-wildcard static route..." >&2  
      # build up absilute path to the file by concatenting the base script directory with the file path defined in the config for this route, this will allow us to correctly resolve the file on disk that corresponds to the request.
      absolute_file_path="${SCRIPT_DIR}/${route_file_path#/}"
      echo "handler-utils: final file path for static route is: $absolute_file_path" >&2
    fi


    # next, irrespective of how we derive the path to file, we validate that the final file path exists on the system before proceeding.
    if [[ -f "$absolute_file_path" ]]; then
      echo "handler-utils: Successfully found static resource for path: $path at file path: $route_file_path" >&2

      # Determine MIME type from filename and stream the file to the client
      local content_type
      content_type=$(getMimeType "$absolute_file_path")
      dispatchFileResponse "$absolute_file_path" "$content_type"

      echo "handler-utils: Static resource response sent for path: $path, closing connection." >&2
    else
      echo "handler-utils: Static resource file not found for path: $path at file path: $route_file_path, the absolute file path was: $absolute_file_path, sending error response." >&2
      dispatchErrorResponse 404 "$path" "$method" "$protocol"
    fi
  else
    echo "handler-utils: Unsupported route type: $route_type or file path definition for Static route type associated with path: $path, sending error response." >&2
    dispatchErrorResponse 1 "$path" "$method" "$protocol"
  fi    
  
}

handleJsonResponseRouteRequest(){
    echo "handler-utils: Handling request for path: $path according to JsonResponse route type..." >&2
}


dispatchErrorResponse(){
    local errorCode="$1"
    local path="$2"
    local method="$3"
    local protocol="$4"

    body='{"status":"Not Found","method":"'"$method"'","path":"'"$path"'","protocol":"'"$protocol"'"}'

    # we generate the error status line based on the provided error code, defaulting to 500 if no valid code is provided.
    case "$errorCode" in
        404)
            printf "HTTP/1.1 404 Not Found\r\n"
            ;;
        400)
            printf "HTTP/1.1 400 Bad Request\r\n"
            ;;
        *)
            printf "HTTP/1.1 500 Internal Server Error\r\n"
            ;;
    esac

    # ....then the rest of the response which will be the same regardless of the specific error code, 
    printf "Content-Type: application/json\r\n"
    printf "Content-Length: %s\r\n" "${#body}"
    printf "Connection: close\r\n"
    printf "\r\n"
    printf "%s" "$body"


}

dispatchSuccessResponse(){
    local content="$1"
    local contentType="$2"
    
     printf "HTTP/1.1 200 OK\r\n"
     printf "Content-Type: %s\r\n" "$contentType"
     printf "Content-Length: %s\r\n" "${#content}"
     printf "Connection: close\r\n"
     printf "\r\n"
     printf "%s" "$content"

}


dispatchFileResponse(){
  local file_path="$1"
  local contentType="$2"

  # Prefer stat for size, fallback to wc -c
  local size
  if ! size=$(stat -c%s "$file_path" 2>/dev/null); then
    size=$(wc -c <"$file_path" 2>/dev/null || echo 0)
  fi

  printf "HTTP/1.1 200 OK\r\n"
  printf "Content-Type: %s\r\n" "$contentType"
  printf "Content-Length: %s\r\n" "$size"
  printf "Connection: close\r\n"
  printf "\r\n"
  cat "$file_path"

}


stripPrefixFromPath() {
    local path="$1"
    local prefix="$2"

    if [[ "$path" == "$prefix" ]]; then
        echo ""
    elif [[ "$path" == "$prefix"/* ]]; then
        echo "${path#"$prefix"/}"
    else
        echo "$path"
    fi
}




#--------------------------------------- ROUTE PARSING METHODS -----------------------------


parseRouteTitle() {
  local route_info="$1"
  jq -r '.Title // empty' <<< "$route_info"
}

parseRoutePath() {
  local route_info="$1"
  jq -r '.Path // empty' <<< "$route_info"
}

parseRouteType() {
  local route_info="$1"
  jq -r '.Type // empty' <<< "$route_info"
}


parseSubHandlerRouteScript() {
  local route_info="$1"
  jq -r '.SubHandlerScript // empty' <<< "$route_info"
}

parseStaticRouteFilePath() {
  local route_info="$1"
  jq -r '.FilePath // empty' <<< "$route_info"
}

parseJsonResponseRoutePayload() {
  local route_info="$1"
  jq -r '.Payload // empty' <<< "$route_info"
}




#--------------------------------------- INBOUND REQUEST PARSING METHODS -----------------------------

parseRequestMethod() {
  local request="$1"
  jq -r '.method' <<< "$request"
}

parseRequestPath() {
  local request="$1"
  jq -r '.path' <<< "$request"
}

parseRequestProtocol() {
  local request="$1"
  jq -r '.protocol' <<< "$request"
}

parseRequestHeaders() {
  local request="$1"
  jq -r '.headers' <<< "$request"
}

parseRequestHeader() {
  local request="$1"
  local header_name="$2"
  jq -r --arg header_name "$header_name" '.headers[$header_name] // empty' <<< "$request"
}

parseRequestQueryString() {
  local request="$1"
  jq -r '.query_string' <<< "$request"
}


parseRequestQueryStringParam() {
  local request="$1"
  local parameter_name="$2"
  jq -r --arg parameter_name "$parameter_name" '.query_string[$parameter_name] // empty' <<< "$request"
}

parseRequestBody() {
  local request="$1"
  jq -r '.body' <<< "$request"
}
