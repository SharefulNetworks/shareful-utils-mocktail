#!/bin/bash

# A collection of helper functions to simplify the process of working with 
# the main server configuration JSON file.


# reads the main JSON config file from the repository root relative to SCRIPT_DIR.
ReadServerJSONConfig() {
    jq -r '.' "${SCRIPT_DIR}/res/config.json"
}

# reads a specific value from the JSON config file using jq a reference
# to the config JSON must be provided as the first argument, and the key to read 
# must be provided as the second argument.
ParseJSONConfigField() {
    local json="$1"
    local path="$2"
    jq -cr "$path" <<< "$json"
}

SetJSONConfigField() {
    local json="$1"
    local path="$2"
    local value="$3"
    jq -cr --arg path "$path" --arg value "$value" 'setpath($path[1:] | split("." ); $value)' <<< "$json"
}

ParseJSONConfigGeneralSetting() {
    local json="$1"
    local setting="$2"
    jq -cr --arg setting "$setting" '.GeneralSettings[$setting] // empty' <<< "$json"
}

ParseJSONConfigSecuritySetting() {
    local json="$1"
    local setting="$2"
    jq -cr --arg setting "$setting" '.SecuritySettings[$setting] // empty' <<< "$json"
}

# Replaces the entire general setttings object with the supplied object.
SetJSONConfigGeneralSettings(){
    local json="$1"
    local newGeneralSettings="$2"
    jq -cr ".GeneralSettings = $newGeneralSettings" <<< "$json"
}

SetJSONConfigSecuritySettings(){
    local json="$1"
    local newSecuritySettings="$2"
    jq -cr ".SecuritySettings = $newSecuritySettings" <<< "$json"
}

SetJSONConfigSecuritySetting(){
    local json="$1"
    local setting="$2"
    local value="$3"
    jq -cr --arg setting "$setting" --arg value "$value" '.SecuritySettings[$setting] = $value' <<< "$json"
}


# Higher-level utility functions.

# Updates the config file with the provided JSON string. If the provided JSON is invalid, 
# the function will refuse to write it to the config file and will return an error.
UpdateConfigFile() {
    local newConfig="$1"
    local configPath="${SCRIPT_DIR}/res/config.json"
    local tempFile

    tempFile="$(mktemp "${configPath}.tmp.XXXXXX")" || return 1
    if ! jq '.' <<< "$newConfig" > "$tempFile"; then
        rm -f "$tempFile"
        echo "UpdateConfigFile: refusing to write invalid JSON to $configPath" >&2
        return 1
    fi
    mv "$tempFile" "$configPath"
}

# Retrieves the stored passphrase from the config JSON, where it exists in the SecuritySettings object. 
# If the passphrase is not found, the function will return an empty string. This is a shorthand
# utility function that combines reading the config JSON from the host file system and parsing 
# the passphrase setting.
GetStoredPassphraseFromConfig() {
    local readConfig
    readConfig="$(ReadServerJSONConfig)"
    ParseJSONConfigSecuritySetting "$readConfig" "Passphrase"
}