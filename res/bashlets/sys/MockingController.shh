#!/bin/bash

# The Mocktail Servers MockingController is a system-level Bashlet that is responsible for handling requests to the 
# to user-defined Mock API's and their respective constituent endpoints. It is invoked by the system-handler when a request 
# matches the "/sys/mock" path prefix and will attempt to map the path provided in the request to a specific Mock API endpoint. 
# The MockingController is also responsible for managing the lifecycle of Mock API's, including their creation, 
# modification, and deletion.


# declare globals
SYSTEM_MOCK_API_COLLECTIONS_BASE_PATH="$SCRIPT_DIR/res/sys/mocks"
USER_MOCK_API_COLLECTIONS_BASE_PATH="$SCRIPT_DIR/res/usr/mocks"

# import/source the BashletContext helper functions to support parsing of the incoming request object and constructing the response object.
source "$SCRIPT_DIR/res/bashlets/internal/BashletContext"

# import/source the MockingController helper functions to support the return of responses to clients as defined in the Mock API collection JSON files.
source "$SCRIPT_DIR/res/handlers/internal/utils/mock-utils"


# init, where defined is automatically invoked by the BashletEngine on the first call to a bashlet, since its only
# called once, it is a good place to perform any initialisation tasks that need to be done before the bashlet can be used.
# Here we load all System and User-defined Mock API collections into memory and cache them in the BashletContext 
# key-value store for immediate access.
init(){

   echo "MockingController: Initializing MockingController Bashlet..." >&2

   # load all mock api collection from the host file system into memory and store them to the BashletContext key-value store, 
   # using their Collection ID as the key, this allows the MockingController to resolve requests to specific Mock API endpoints...

   # first load system (example) collections...
   loadMockAPICollections "$SYSTEM_MOCK_API_COLLECTIONS_BASE_PATH"

   # next load user-defined collections
   loadMockAPICollections "$USER_MOCK_API_COLLECTIONS_BASE_PATH"

   mockAPICollectionMetaDataArr=$(KVRead "mockAPICollectionsMetaData")

   echo "Loaded Mock API collections metadata: $mockAPICollectionMetaDataArr" >&2

}


#----------------------------------------Mock API Collection Request Handlers-------------------------------------------------------

# Facilitates a GET request/response cycle to a user-defined Mock API endpoint, by using the request path to resolve the target Mock API
# collection via its assigned BASE PATH, the remainder of the request path is then used to resolve the specific 
# endpoint within that Mock API collection, to which the request is directed.
# @route method=get path=/
invokeGET(){
    request="$1"
    response="$2"

    #here we really just intercept the request GET HTTP method and redirect it to the invokeEndpoint function.
    invokeEndpoint "$request" "$response"

}



# Facilitates a POST request/response cycle to a user-defined Mock API endpoint, by using the request path to resolve the target Mock API
# collection via its assigned BASE PATH, the remainder of the request path is then used to resolve the specific 
# endpoint within that Mock API collection, to which the request is directed.
# @route method=post path=/
invokePOST(){
    request="$1"
    response="$2"

    #here we really just intercept the request POST HTTP method and redirect it to the invokeEndpoint function.
    invokeEndpoint "$request" "$response"

}



# Facilitates a PUT request/response cycle to a user-defined Mock API endpoint, by using the request path to resolve the target Mock API
# collection via its assigned BASE PATH, the remainder of the request path is then used to resolve the specific 
# endpoint within that Mock API collection, to which the request is directed.
# @route method=put path=/
invokePUT(){
    request="$1"
    response="$2"

    #here we really just intercept the request PUT HTTP method and redirect it to the invokeEndpoint function.
    invokeEndpoint "$request" "$response"

}



# Facilitates a DELETE request/response cycle to a user-defined Mock API endpoint, by using the request path to resolve the target Mock API
# collection via its assigned BASE PATH, the remainder of the request path is then used to resolve the specific 
# endpoint within that Mock API collection, to which the request is directed.
# @route method=delete path=/
invokeDELETE(){
    request="$1"
    response="$2"

    #here we really just intercept the request DELETE HTTP method and redirect it to the invokeEndpoint function.
    invokeEndpoint "$request" "$response"

}











# --------------------------------------------  Mocking Service UI Routes ---------------------------------------------------

# Navigates to the MockingController dashboard page, which provides a user interface for managing Mock API collections 
# and their constituent endpoints.
# @route method=get path=/dashboard secure=true
viewMockingDashboard(){
    request="$1"
    response="$2"

    echo "MockingController: Inside viewMockingDashboard function..." >&2

    ForwardBashletRequest "/sys/ui/mocktail-mocking-dashboard.html"
   
}














# ----------------Mocking Service API Endpoint Routes, intended to be called from within the context of system UI pages---------------

# API endpoint to return a list of all Mock API collections that have been loaded into the MockingController Bashlet,
# @route method=get path=/api/collections
apiListMockAPICollections(){
    request="$1"
    response="$2"

    echo "MockingController: Inside apiListMockAPICollections function..." >&2

    # attempt to load mock api collection metadata from the BashletContext key-value store,
    # if it exists, otherwise return an empty array. The data should have been loaded into 
    # the BashletContext key-value store on initialisation of the MockingController bashlet.
    local loadedMockAPICollectionMetaData=[]
    if KVExists "mockAPICollectionsMetaData"; then
        loadedMockAPICollectionMetaData=$(KVRead "mockAPICollectionsMetaData")
    fi 

    # set the response body to the JSON meta data object we have loaded.
    SetBashletResponseBody "$response" "$loadedMockAPICollectionMetaData"     
   
}


# API endpoint to retrieve a specific Mock API collection (and all its constituent endpoints) 
# by its Collection ID, which is provided as a path parameter in the request.
# @route method=get path=/api/collections/{collectionId}
apiGetMockAPICollection(){

    request="$1"
    response="$2"

    echo "MockingController: Inside apiGetMockAPICollection function..." >&2

    # parse the collection id from the request path.
    local collectionId
    collectionId=$(ParseBashletRequestPathParam "$request" "collectionId")

    # next we check the mock api collection exists in the BashletContext key-value store, if it does not exist, return a 404 error to the client.
    if ! KVExists "$collectionId"; then
        local responseBody={}
        responseBody=$(SetJSONField "$responseBody" '.status' '404')
        responseBody=$(SetJSONField "$responseBody" '.statusMessage' "Not Found - Mock API Collection with Id: $collectionId does not exist.")
        SendBashletErrorResponse "404"  "$responseBody" "$request"
        return 1
    fi

    # otherwise retrieve the existing Mock API collection from the BashletContext key-value store and set it as the response body
    # that will ultimately be returned to the client.
    local existingMockAPICollection
    existingMockAPICollection=$(KVRead "$collectionId")


    # set the response body to the JSON object we have loaded.
    SetBashletResponseBody "$response" "$existingMockAPICollection"
}


# API endpoint to create a new Mock API collection, the request body must contain a the requsite Mock API collection details,
# i.e Name,Description and Id as an absolute minimum, these will be used to crrate a NEW Mock API collection 
# which will bestored in the BashletContext key-value store, using its Collection ID as the key for immediate access
# AND also persisted to the host file system for future use.
# @route method=post path=/api/collections
apiCreateMockAPICollection(){
    request="$1"
    response="$2"

    echo "MockingController: Inside apiCreateMockAPICollection function..." >&2

    # parse the posted JSON body from the request, which contains the new Mock API collection details,
    requestBody="$(ParseBashletRequestBody "$request")"

    # parse the requsite fields from the request body
    newMockAPIName=$(ParseJSONField "$requestBody" '.Name')
    newMockAPIDescription=$(ParseJSONField "$requestBody" '.Description')

    # generate a collection id from the provided name by converting it to lowercase, replacing spaces with hyphens,
    # and removing any non-alphanumeric characters except hyphens.
    newMockAPIId=$(generateCollectionIdFromName "$newMockAPIName")

    # check if the id already exists in the BashletContext key-value store, if it does return a 400 error to the client.
    if KVExists "$newMockAPIId"; then
       
        local err_status_code=400
        local error_content={}
        error_content=$(SetJSONField "$error_content" '.status' "400")
        error_content=$(SetJSONField "$error_content" '.statusMessage' "Bad Request - Mock APICollection with Id: $newMockAPIId already exists.")
        SendBashletErrorResponse "$err_status_code" "$error_content" "$request"
        return 1
    fi

    # build up new Mock API Collection JSON object/document using the provided details and some default values for the other required fields.
    newMockAPICollection="{}"
    newMockAPICollection=$(SetJSONField "$newMockAPICollection" '.Name' "$newMockAPIName")
    newMockAPICollection=$(SetJSONField "$newMockAPICollection" '.Description' "$newMockAPIDescription")
    newMockAPICollection=$(SetJSONField "$newMockAPICollection" '.CollectionId' "$newMockAPIId")
    newMockAPICollection=$(SetJSONField "$newMockAPICollection" '.Version' '1.0')
    newMockAPICollection=$(SetJSONField "$newMockAPICollection" '.Endpoints' '[]')   # empty endpoint array this can be updated later.


    # store the new Mock API collection to the BashletContext key-value store and persist it to the host file system.
    # our private will assist us in this regard.
    storeCollection "$newMockAPIId" "$newMockAPICollection"


    # finally return a response to the caller
    local responseBody={}
    responseBody=$(SetJSONField "$responseBody" '.status' '201')
    responseBody=$(SetJSONField "$responseBody" '.statusMessage' "Created - Mock API Collection with Id: $newMockAPIId has been created successfully.")
    SetBashletResponseStatusCode "$response" "201"
    SetBashletResponseBody "$response" "$responseBody"



}


# API endpoint to update an existing Mock API collection, the request body must contain a valid Mock API collection JSON object,
# which will be parsed and stored in the BashletContext key-value store, using its Collection ID as the key for immediate access 
# and also persisted to the host file system for future use. 
# NB: This endpoint is intended to be used for updating TOP-LEVEL Mock API collection properties, such as the collection name, 
#     description, and base path. It is not intended to be used for updating individual endpoints within the collection, 
#      which should be done via the apiUpdateMockAPICollectionEndpoint endpoint.
# @route method=put path=/api/collections/{collectionId}
apiUpdateMockAPICollection(){
    request="$1"
    response="$2"

    echo "MockingController: Inside apiUpdateMockAPICollection function..." >&2

    # parse the collection id from the request path.
    collectionId=$(ParseBashletRequestPathParam "$request" "collectionId")

    # if the collection id is empty, return a 400 error to the client.
    if [ -z "$collectionId" ]; then
        local responseBody={}
        responseBody=$(SetJSONField "$responseBody" '.status' '400')
        responseBody=$(SetJSONField "$responseBody" '.statusMessage' "Bad Request - Missing required path parameter: collectionId.")
        SendBashletErrorResponse "400"  "$responseBody" "$request"
        return 1
    fi

    # next parse the posted JSON body from the request, which contains the new Mock API collection details,
    requestBody="$(ParseBashletRequestBody "$request")"

    # parse the requsite fields from the request body
    mockAPIName=$(ParseJSONField "$requestBody" '.Name')
    mockAPIDescription=$(ParseJSONField "$requestBody" '.Description')
    mockAPIVersion=$(ParseJSONField "$requestBody" '.Version')

    # check if a Mock API collection with the provided exists and  has been cached in the BashletContext key-value store, 
    # if it does not exist, return a 404 error to the client.
    if ! KVExists "$collectionId"; then
        local responseBody={}
        responseBody=$(SetJSONField "$responseBody" '.status' '404')
        responseBody=$(SetJSONField "$responseBody" '.statusMessage' "Not Found - Mock API Collection with Id: $collectionId does not exist.")
        SendBashletErrorResponse "404"  "$responseBody" "$request"
        return 1
    fi

    # check that a value has been provided for the required fields, if not return a 400 error to the client.
    if [ -z "$mockAPIName" ] || [ -z "$mockAPIDescription" ] || [ -z "$mockAPIVersion" ]; then
        local responseBody={}
        responseBody=$(SetJSONField "$responseBody" '.status' '400')
        responseBody=$(SetJSONField "$responseBody" '.statusMessage' "Bad Request - Missing required fields in request body. Name, Description and Version are required.")
        SendBashletErrorResponse "400"  "$responseBody" "$request"
        return 1
    fi  

    # retrieve the existing Mock API collection from the BashletContext key-value store, which we will update with the new values.
    existingMockAPICollection=$(KVRead "$collectionId")

    # update the existing Mock API collection with the new values from the request body.
    updatedMockAPICollection=$(SetJSONField "$existingMockAPICollection" '.Name' "$mockAPIName")
    updatedMockAPICollection=$(SetJSONField "$updatedMockAPICollection" '.Description' "$mockAPIDescription")
    updatedMockAPICollection=$(SetJSONField "$updatedMockAPICollection" '.Version' "$mockAPIVersion")

    # store the updated Mock API collection to the BashletContext key-value store and persist it to the host file system.
    storeCollection "$collectionId" "$updatedMockAPICollection"

    # finally return a response to the caller
    local responseBody={}
    responseBody=$(SetJSONField "$responseBody" '.status' '200')
    responseBody=$(SetJSONField "$responseBody" '.statusMessage' "OK - Mock API Collection with Id: $collectionId has been updated successfully.")
    SetBashletResponseBody "$response" "$responseBody"

}



# API endpoint to delete an existing Mock API collection and all constituent endpoints, the request path must contain 
# the Collection ID of the Mock API collection to be deleted.
# @route method=delete path=/api/collections/{collectionId}
apiDeleteMockAPICollection(){
    request="$1"
    response="$2"

    echo "MockingController: Inside apiDeleteMockAPICollection function..." >&2

     # parse the collection id from the request path.
     collectionId=$(ParseBashletRequestPathParam "$request" "collectionId")

     # if the collection id is empty, return a 400 error to the client.
    if [ -z "$collectionId" ]; then
        local responseBody={}
        responseBody=$(SetJSONField "$responseBody" '.status' '400')
        responseBody=$(SetJSONField "$responseBody" '.statusMessage' "Bad Request - Missing required path parameter: collectionId.")
        SendBashletErrorResponse "400"  "$responseBody" "$request"
        return 1
    fi

    # if the collection exists in the BashletContext key-value store, if it does not exist, return a 404 error to the client.
    if ! KVExists "$collectionId"; then
        local responseBody={}
        responseBody=$(SetJSONField "$responseBody" '.status' '404')
        responseBody=$(SetJSONField "$responseBody" '.statusMessage' "Not Found - Mock API Collection with Id: $collectionId does not exist and thus cannot be deleted.")
        SendBashletErrorResponse "404"  "$responseBody" "$request"
        return 1
    fi

    # where the collection DOES exist, delete from the file system and the BashletContext key-value store, out helper function 
    # will assist us in this regard.
    deleteCollection "$collectionId"


    # finally return a response to the caller
    local responseBody={}
    responseBody=$(SetJSONField "$responseBody" '.status' '200')
    responseBody=$(SetJSONField "$responseBody" '.statusMessage' "OK - Mock API Collection with Id: $collectionId has been deleted successfully.")
    SetBashletResponseBody "$response" "$responseBody"
}




# API endpoint to create a new Mock API endpoint within an existing Mock API collection, the request body must contain 
# the requsite Mock API Collection, Endpoint details, otherwise a 400 (bad request) error will be returned to the client. 
# The new endpoint will be appended to the existing Mock API collection's associated with the id providedas a path parameter 
# in the request.
# @route method=post path=/api/collections/{collectionId}/endpoints
apiCreateMockAPICollectionEndpoint(){
    request="$1"
    response="$2"

    echo "MockingController: Inside apiCreateMockAPICollectionEndpoint function..." >&2

    # parse the collection id from the request path.
    local collectionId=$(ParseBashletRequestPathParam "$request" "collectionId")

    echo "MockingController: Parsed collectionId: $collectionId" >&2

    # if the collection id is empty, return a 400 error to the client.
    if [ -z "$collectionId" ]; then
        local responseBody={}
        responseBody=$(SetJSONField "$responseBody" '.status' '400')
        responseBody=$(SetJSONField "$responseBody" '.statusMessage' "Bad Request - Missing required path parameter: collectionId.")
        SendBashletErrorResponse "400"  "$responseBody" "$request"
        return 1
    fi  

    # next attempt to obtain reference to the Mock API collection from the BashletContext key-value store, if it does not exist, return a 404 error to the client.
    if ! KVExists "$collectionId"; then
        local responseBody={}
        responseBody=$(SetJSONField "$responseBody" '.status' '404')
        responseBody=$(SetJSONField "$responseBody" '.statusMessage' "Not Found - Mock API Collection with Id: $collectionId does not exist and thus cannot be updated.")
        SendBashletErrorResponse "404"  "$responseBody" "$request"
        return 1
    fi

    # otherwise retrieve the existing Mock API collection from the BashletContext key-value store, which we will update with the new endpoint.
    local existingMockAPICollection=$(KVRead "$collectionId")

    # parse the posted JSON body from the request, which contains the new Mock API endpoint details,
    local requestBody="$(ParseBashletRequestBody "$request")"

    # parse the requsite fields from the request body
    local newEndpointPath=$(ParseJSONField "$requestBody" '.Path')
    local newEndpointMethod=$(ParseJSONField "$requestBody" '.Method')
    local newEndpointResponse=$(ParseJSONField "$requestBody" '.Response')

    # parse the optional EnableDynamicParamSubstitution field if its provided.
    local enableDynamicParamSubstitution=$(ParseJSONField "$requestBody" '.EnableDynamicParamSubstitution')

    # check that a value has been provided for the required fields, if not return a 400 error to the client.
    if [ -z "$newEndpointPath" ] || [ -z "$newEndpointMethod" ] || [ -z "$newEndpointResponse" ]; then
        local responseBody={}
        responseBody=$(SetJSONField "$responseBody" '.status' '400')
        responseBody=$(SetJSONField "$responseBody" '.statusMessage' "Bad Request - Missing required fields in request body. Path, Method and Response are required.")
        SendBashletErrorResponse "400"  "$responseBody" "$request"
        return 1
    fi

    # ensure that method is GET,POST,PUT,PATCH or DELETE, (case insensitive) if not return a 400 error to the client.
    if ! [[ "$newEndpointMethod" =~ ^(GET|POST|PUT|PATCH|DELETE)$ ]]; then
        local responseBody={}
        responseBody=$(SetJSONField "$responseBody" '.status' '400')
        responseBody=$(SetJSONField "$responseBody" '.statusMessage' "Bad Request - Invalid method. Only GET, POST, PUT, PATCH and DELETE are supported.")
        SendBashletErrorResponse "400"  "$responseBody" "$request"
        return 1
    fi

    # next validate that the response includes a Body it may also include a Header object and status code, but these are optional
    # if not, return a 400 error to the client.
    local body=$(ParseJSONField "$newEndpointResponse" '.Body')
    if [ -z "$body" ]; then
        local responseBody={}
        responseBody=$(SetJSONField "$responseBody" '.status' '400')
        responseBody=$(SetJSONField "$responseBody" '.statusMessage' "Bad Request - Invalid response. Response must include a Body.")
        SendBashletErrorResponse "400"  "$responseBody" "$request"
        return 1
    fi

    # use the details provided in the response object to build a new endpoint object.
    local newEndpoint="{}"
    newEndpoint=$(SetJSONField "$newEndpoint" '.Path' "$newEndpointPath")
    newEndpoint=$(SetJSONField "$newEndpoint" '.Method' "$newEndpointMethod")
    newEndpoint=$(SetJSONField "$newEndpoint" '.Response' "$newEndpointResponse")

    # set the EnableDynamicParamSubstitution field if it was provided.
    if [ -n "$enableDynamicParamSubstitution" ] && [ "$enableDynamicParamSubstitution" != "null" ]; then
        newEndpoint=$(SetJSONField "$newEndpoint" '.EnableDynamicParamSubstitution' "$enableDynamicParamSubstitution")
    fi

     # get the current endpoint count and increment this value to product the new endpoint id.
    currentEndpointCount=$(GetMockAPICollectionEndpintCount "$existingMockAPICollection")
    newEndpointId="$((currentEndpointCount + 1))"
    newEndpoint=$(SetJSONString "$newEndpoint" '.Id' "$newEndpointId")

    # if an endpoint with the specified path and method already exists in the Mock API collection, return a 400 error to the client.
    if EndpointExistsInMockAPICollection "$existingMockAPICollection" "$newEndpointPath" "$newEndpointMethod"; then
        local responseBody={}
        responseBody=$(SetJSONField "$responseBody" '.status' '400')
        responseBody=$(SetJSONField "$responseBody" '.statusMessage' "Bad Request - Endpoint already exists that references path $newEndpointPath in Mock API Collection with Id: $collectionId.")
        SendBashletErrorResponse "400"  "$responseBody" "$request"
        return 1
    fi


    # append the new endpoint to the existing Mock API collection's Endpoints array.
    local endpointsArray=$(ParseMockAPICollectionEndpoints "$existingMockAPICollection")
    endpointsArray=$(AppendJSONArrayItem "$endpointsArray" "$newEndpoint")
    updatedMockAPICollection=$(SetJSONField "$existingMockAPICollection" '.Endpoints' "$endpointsArray")

    # store the updated Mock API collection to the BashletContext key-value store and persist it to the host file system.
    storeCollection "$collectionId" "$updatedMockAPICollection"

    # finally return a response to the caller
    local responseBody={}
    responseBody=$(SetJSONField "$responseBody" '.status' '201')
    responseBody=$(SetJSONField "$responseBody" '.statusMessage' "Created - Mock API Endpoint has been created successfully in Mock API Collection with Id: $collectionId.")
    SetBashletResponseStatusCode "$response" "201"
    SetBashletResponseBody "$response" "$responseBody"

}

# API endpoint to update an existing Mock API endpoint within a Mock API collection, the request body must contain 
# the requsite Mock API Collection, Endpoint details, otherwise a 400 (bad request) error will be returned to the client. 
# @route method=put path=/api/collections/{collectionId}/endpoints/{endpointId}
apiUpdateMockAPICollectionEndpoint(){
    request="$1"
    response="$2"

    echo "MockingController: Inside apiUpdateMockAPICollectionEndpoint function..." >&2

    # we start by parsing both path parameters from the request, first the collection id...
    local collectionId=$(ParseBashletRequestPathParam "$request" "collectionId")

    # then the endpoint id
    local endpointId=$(ParseBashletRequestPathParam "$request" "endpointId")

     # next attempt to obtain reference to the Mock API collection from the BashletContext key-value store, if it does not exist, return a 404 error to the client.
    if ! KVExists "$collectionId"; then
        local responseBody={}
        responseBody=$(SetJSONField "$responseBody" '.status' '404')
        responseBody=$(SetJSONField "$responseBody" '.statusMessage' "Not Found - Mock API Collection with Id: $collectionId does not exist and thus cannot be updated.")
        SendBashletErrorResponse "404"  "$responseBody" "$request"
        return 1
    fi

    # otherwise retrieve the existing Mock API collection from the BashletContext key-value store, which we will update with the new endpoint.
    local existingMockAPICollection
    existingMockAPICollection=$(KVRead "$collectionId")

    echo "Existing Mock API Collection: $existingMockAPICollection" >&2

    # next check that the endpoint exists in the Mock API collection, if it does not exist, return a 404 error to the client.
    # if an endpoint with the specified path and method already exists in the Mock API collection, return a 400 error to the client.
    local existingEndpoint
    existingEndpoint=$(GetMockAPICollectionEndpointById "$existingMockAPICollection" "$endpointId")
    if [ -z "$existingEndpoint" ]; then
        local responseBody={}
        responseBody=$(SetJSONField "$responseBody" '.status' '404')
        responseBody=$(SetJSONField "$responseBody" '.statusMessage' "Not Found - Mock API Endpoint with Id: $endpointId does not exist in Mock API Collection with Id: $collectionId and thus cannot be updated.")
        SendBashletErrorResponse "404"  "$responseBody" "$request"
        return 1
    fi

    # conversely where the endpoint DOES exist, we parse the posted JSON body from the request, which contains the new Mock API endpoint details,
    local requestBody
    requestBody="$(ParseBashletRequestBody "$request")"


    # parse the requsite fields from the request body, all fields (apart from the id) can be updated.
    local newEndpointPath=$(ParseJSONField "$requestBody" '.Path')
    local newEndpointMethod=$(ParseJSONField "$requestBody" '.Method')
    local newEndpointResponse=$(ParseJSONField "$requestBody" '.Response')

    # parse the optional EnableDynamicParamSubstitution field if its provided.
    local enableDynamicParamSubstitution=$(ParseJSONField "$requestBody" '.EnableDynamicParamSubstitution')


    # update the existing endpoint with the detals obtained from the request.
    local updatedEndpoint
    updatedEndpoint=$(SetJSONField "$existingEndpoint" '.Path' "$newEndpointPath")
    updatedEndpoint=$(SetJSONField "$updatedEndpoint" '.Method' "$newEndpointMethod")
    updatedEndpoint=$(SetJSONField "$updatedEndpoint" '.Response' "$newEndpointResponse")

    # set the EnableDynamicParamSubstitution field if it was provided and is not null
    if [ -n "$enableDynamicParamSubstitution" ] && [ "$enableDynamicParamSubstitution" != "null" ]; then
        updatedEndpoint=$(SetJSONField "$updatedEndpoint" '.EnableDynamicParamSubstitution' "$enableDynamicParamSubstitution")
    else
        # if the field is not provided or is null, we remove it from the endpoint object.
        updatedEndpoint=$(RemoveJSONField "$updatedEndpoint" '.EnableDynamicParamSubstitution')
    fi

    # update the existing Mock API collection with the updated endpoint.
    local updatedMockAPICollection
    updatedMockAPICollection=$(UpdateMockAPICollectionEndpointById "$existingMockAPICollection" "$endpointId" "$updatedEndpoint")

    # store the updated Mock API collection to the BashletContext key-value store and persist it to the host file system.
    storeCollection "$collectionId" "$updatedMockAPICollection"

    # finally return a response to the caller
    local responseBody={}
    responseBody=$(SetJSONField "$responseBody" '.status' '200')
    responseBody=$(SetJSONField "$responseBody" '.statusMessage' "OK - Mock API Endpoint with Id: $endpointId has been updated successfully in Mock API Collection with Id: $collectionId.")
    SetBashletResponseBody "$response" "$responseBody"  

}

# API endpoint to delete an existing Mock API endpoint within a Mock API collection, the request path must contain 
# the Collection ID of the Mock API collection and the Endpoint ID of the endpoint to be deleted
# @route method=delete path=/api/collections/{collectionId}/endpoints/{endpointId}
apiDeleteMockAPICollectionEndpoint(){
    request="$1"
    response="$2"   


    echo "MockingController: Inside apiDeleteMockAPICollectionEndpoint function..." >&2

    # we start by parsing both path parameters from the request, first the collection id...
    local collectionId
    collectionId=$(ParseBashletRequestPathParam "$request" "collectionId")

    # then the endpoint id
    local endpointId
    endpointId=$(ParseBashletRequestPathParam "$request" "endpointId")

     # next attempt to obtain reference to the Mock API collection from the BashletContext key-value store, if it does not exist, return a 404 error to the client.
    if ! KVExists "$collectionId"; then
        local responseBody={}
        responseBody=$(SetJSONField "$responseBody" '.status' '404')
        responseBody=$(SetJSONField "$responseBody" '.statusMessage' "Not Found - Mock API Collection with Id: $collectionId does not exist and thus cannot be deleted.")
        SendBashletErrorResponse "404"  "$responseBody" "$request"
        return 1
    fi

    # otherwise retrieve the existing Mock API collection from the BashletContext key-value store, which we will update with the new endpoint.
    local existingMockAPICollection
    existingMockAPICollection=$(KVRead "$collectionId")

    echo "Existing Mock API Collection: $existingMockAPICollection" >&2

    # next check that the endpoint exists in the Mock API collection, if it does not exist, return a 404 error to the client.
    # if an endpoint with the specified path and method already exists in the Mock API collection, return a 400 error to the client.
    local existingEndpoint
    existingEndpoint=$(GetMockAPICollectionEndpointById "$existingMockAPICollection" "$endpointId")
    if [ -z "$existingEndpoint" ]; then
        local responseBody={}
        responseBody=$(SetJSONField "$responseBody" '.status' '404')
        responseBody=$(SetJSONField "$responseBody" '.statusMessage' "Not Found - Mock API Endpoint with Id: $endpointId does not exist in Mock API Collection with Id: $collectionId and thus cannot be deleted.")
        SendBashletErrorResponse "404"  "$responseBody" "$request"
        return 1
    fi

    # conversely where the endpoint DOES exist, we remove the endpoint from the existing Mock API collection.
    local updatedMockAPICollection
    updatedMockAPICollection=$(RemoveMockAPICollectionEndpointById "$existingMockAPICollection" "$endpointId")

    # store the updated Mock API collection to the BashletContext key-value store and persist it to the host file system.
    storeCollection "$collectionId" "$updatedMockAPICollection"

    # finally return a response to the caller
    local responseBody={}
    responseBody=$(SetJSONField "$responseBody" '.status' '200')
    responseBody=$(SetJSONField "$responseBody" '.statusMessage' "OK - Mock API Endpoint with Id: $endpointId has been deleted successfully from Mock API Collection with Id: $collectionId.")
    SetBashletResponseBody "$response" "$responseBody"
}














#-------------------------------------Helper functions for the MockingController Bashlet--------------------------------------


# stores or update mock API collection with the specified collection id. The storage operation creates/updates 3 distinct
# artifacts: 
#
# 1)First the the Mock API collection JSON object is stored to the host file system 
#
# 2)Next the Mock API collection JSON object is stored to the BashletContext key-value store, using its Collection ID 
#   as the key for immediate access, this is vital as all Mock API Collections are loaded into memory on initialisation of the MockingController bashlet 
#   and cached in the BashletContext key-value store. From that point forward all requests to Mock API endpoints are resolved from the BashletContext key-value store, 
#   which negates the need to read the data from the file system on every request.
#
# 3)Finally the Mock API collection metadata is updated in the BashletContext key-value store, which is used to provide a list of all loaded Mock API collections to the client.
storeCollection(){
    collectionId="$1"
    mockAPICollectionJSON="$2"


    # store the new Mock API COllection to the file system using the Collection id value as the file name.
    StoreMockAPICollection "$mockAPICollectionJSON" "$USER_MOCK_API_COLLECTIONS_BASE_PATH/$collectionId.json"

    # As all mock api collections are load into memory/cached (via the BashletContext key-value store) on initialisation 
    # of the server the new entry should be added to the BashletContext key-value store to enable immediate access to it and its constituent endpoints.
    KVStore "$collectionId" "$mockAPICollectionJSON"

    # We also need to store metadata related to the new collection to the mockAPICollectionsMetaData array in the BashletContext key-value store, which is used to provide a list of all loaded Mock API collections to the client.
    local loadedMockAPICollectionMetaData="[]"
    if KVExists "mockAPICollectionsMetaData"; then
        loadedMockAPICollectionMetaData=$(KVRead "mockAPICollectionsMetaData")
    fi 

    # attempt to locate the mock api collection metadata in the loadedMockAPICollectionMetaData array, if it exists,
    # grab reference to its index as we will use this to replace the existing metadata with the updated metadata for the collection.
    local collectionIndex=-1
    collectionIndex=$(GetMockAPICollectionIndexById "$loadedMockAPICollectionMetaData" "$collectionId")

    # get the endpoint count, we'll need it for the meta data object we'll go on to generate.
    endpointCount=$(ParseMockAPICollectionField "$mockAPICollectionJSON" '.Endpoints | length')
    name=$(ParseMockAPICollectionField "$mockAPICollectionJSON" '.Name')

    # Generate the new metadata for the collection, which will be used to replace the existing metadata in the loadedMockAPICollectionMetaData array.
    local newCollectionMetadata
    newCollectionMetadata="{}"
    newCollectionMetadata="$(SetJSONString "$newCollectionMetadata" '.CollectionId' "$collectionId")"
    newCollectionMetadata="$(SetJSONString "$newCollectionMetadata" '.Name' "$name")"
    newCollectionMetadata="$(SetJSONNumber "$newCollectionMetadata" '.EndpointCount' "$endpointCount")"

   
    # replace or append the new metadata to the loadedMockAPICollectionMetaData array, depending on whether the collection was found in the array or not.
    # Note: We will really only be replacing an existing metadata entry if this function is being called in respect of
    # an update to an existing Mock API collection, otherwise we will be appending the new metadata to the array.
    if [[ $collectionIndex -ne -1 ]]; then
        # Replace the existing metadata with the updated metadata.
        loadedMockAPICollectionMetaData="$(SetJSONArrayItem "$loadedMockAPICollectionMetaData" "$collectionIndex" "$newCollectionMetadata")"
    else
        # Append the new metadata to the array.
        loadedMockAPICollectionMetaData="$(AppendJSONArrayItem "$loadedMockAPICollectionMetaData" "$newCollectionMetadata")"
    fi

    # Finally Store the updated metadata array back to the BashletContext.
    KVStore "mockAPICollectionsMetaData" "$loadedMockAPICollectionMetaData"
}


deleteCollection(){
    collectionId="$1"

    # delete the Mock API collection file from the host file system.
    DeleteMockAPICollection "$USER_MOCK_API_COLLECTIONS_BASE_PATH/$collectionId.json"

    # delete the Mock API collection from the BashletContext key-value store.
    KVDelete "$collectionId"

    # delete the Mock API collection metadata from the BashletContext key-value store.
    local loadedMockAPICollectionMetaData="[]"
    if KVExists "mockAPICollectionsMetaData"; then
        loadedMockAPICollectionMetaData=$(KVRead "mockAPICollectionsMetaData")
    fi 

    # attempt to locate the mock api collection metadata in the loadedMockAPICollectionMetaData array, if it exists,
    # grab reference to its index as we will use this to remove the existing metadata for the collection.
    local collectionIndex=-1
    collectionIndex=$(GetMockAPICollectionIndexById "$loadedMockAPICollectionMetaData" "$collectionId")

    # remove the metadata from the array, if it was found.
    if [[ $collectionIndex -ne -1 ]]; then
        loadedMockAPICollectionMetaData="$(RemoveJSONArrayItem "$loadedMockAPICollectionMetaData" "$collectionIndex")"
        KVStore "mockAPICollectionsMetaData" "$loadedMockAPICollectionMetaData"
    fi


}

# requests to all invoke* functions are routed to this function, which is responsible for resolving the target Mock API collection and endpoint
# based on the request path, and then returning the defined response for the endpoint to the client.
invokeEndpoint(){
    request="$1"
    response="$2"

    # parse the collection id from the request path, which is expected to be the 3rd segment of the path.
    collectionId=$(ParseBashletRequestPathSegment "$request" 3)

    # parse the endpoint path from the request path, which is expected to be everything after the 3rd segment of the path.
    endpointPath=$(ParseBashletRequestSubPath "$request" 4)
    endpointPath="$(EnsureLeadingSlash "$endpointPath")"
    if [[ "$endpointPath" != "/" ]]; then
        endpointPath="${endpointPath%/}"
    fi

    echo "The endpoint path is: $endpointPath" >&2

    # parse request method, used when resolving the endpoint definition.
    requestMethod=$(ParseBashletRequestMethod "$request")

    # use the collection id to lookup the Mock API collection in the BashletContext key-value store, and return the parsed JSON object.
    mockAPICollection=$(lookupMockAPICollectionById "$collectionId")

    # where a collection could not be found with the provided collection id, return a 404 error to the client.
    if [[ $? -ne 0 ]]; then
        echo "MockingController: No Mock API collection found with Id: $collectionId" >&2
        
        # prep and return 404 error
        local err_status_code=404
        local err_content="Not Found - Failed to find the requested resource. No Mock API collection found with Id: $collectionId"
        SendBashletErrorResponse "$err_status_code" "$err_content" "$request"
        return 1
    fi

    echo "MockingController: Resolved Mock API Collection Id: $collectionId from request path." >&2

    # resolve target endpoint from the collection, preferring exact static path matches
    # before falling back to parameterized path matches (e.g. /users/{userId}).
    matchedEndpoint=$(ResolveMockEndpoint "$mockAPICollection" "$endpointPath" "$requestMethod")
    if [[ $? -ne 0 || -z "$matchedEndpoint" ]]; then
        echo "MockingController: No endpoint matched path '$endpointPath' for method '$requestMethod' in collection '$collectionId'" >&2

        local err_status_code=404
        local err_content="Not Found - No endpoint matched path: $endpointPath for method: $requestMethod"
        SendBashletErrorResponse "$err_status_code" "$err_content" "$request"
        return 1
    fi

    echo "MockingController: Resolved Mock API Endpoint for path '$endpointPath' and method '$requestMethod' in collection '$collectionId'" >&2

    # generate the response from the matched endpoint definition and return it to the client.
    generateResponseFromMatchedEndpoint "$request" "$response" "$matchedEndpoint"

}




lookupMockAPICollectionById(){
    collectionId="$1"

    # attempt to get value from the BashletContexts key-value store
    if  KVExists "$collectionId"; then
        mock_json=$(KVRead "$collectionId")
        echo "MockingController: Found Mock API collection with Id: $collectionId" >&2
        echo "$mock_json"
    else
        echo "MockingController: No Mock API collection found with Id: $collectionId" >&2
        return 1
    fi

}

# called on initialisation of the MockingController bashlet to load Mock API Collections into memory
# and cached the mappings, thereby negating the need to have to read the data from the file system on every request.
loadMockAPICollections(){
    local mockAPICollectionsDirPath="$1"

   # 1. Initialize the array once in the parent shell
   local mockAPICollectionMetaDataArr="[]"
   if KVExists "mockAPICollectionsMetaData"; then
       mockAPICollectionMetaDataArr=$(KVRead "mockAPICollectionsMetaData")
   fi

   # 2. Enumerate the JSON files in the provided directory without using a pipe,
   # so the metadata array keeps accumulating in the current shell.
   for mock_file in "$mockAPICollectionsDirPath"/*.json; do
       [[ -e "$mock_file" ]] || continue

        echo "MockingController: Loading Mock API collection from file: $mock_file" >&2

        mock_json=$(ReadMockAPICollection "$mock_file")

        # parse the collection id from the Mock API collection.
        collectionId=$(ParseMockAPICollectionField "$mock_json" '.CollectionId')

        # parse the collection name from the Mock API collection.
        name=$(ParseMockAPICollectionField "$mock_json" '.Name')

        # get the endpoint count.
        endpointCount=$(ParseMockAPICollectionField "$mock_json" '.Endpoints | length')

        # store the loaded Mock API collection in the BashletContext key-value store
        KVStore "$collectionId" "$mock_json"

        # construct a metadata object
        local mockAPICollectionMetadata="{}"
        mockAPICollectionMetadata="$(SetJSONString "$mockAPICollectionMetadata" '.CollectionId' "$collectionId")"
        mockAPICollectionMetadata="$(SetJSONString "$mockAPICollectionMetadata" '.Name' "$name")"
        mockAPICollectionMetadata="$(SetJSONNumber "$mockAPICollectionMetadata" '.EndpointCount' "$endpointCount")"

        # 3. This update now safely persists in parent memory!
        mockAPICollectionMetaDataArr="$(AppendJSONArrayItem "$mockAPICollectionMetaDataArr" "$mockAPICollectionMetadata")"

        echo "MockingController: Loaded Mock API collection with Id: $collectionId and Name: $name" >&2

    done
 
   # 4. Store the completely accumulated metadata array exactly ONCE
   KVStore "mockAPICollectionsMetaData" "$mockAPICollectionMetaDataArr"
}


setResponseHeadersFromEndpoint(){
    response="$1"
    matchedEndpoint="$2"

    # parse and set the response headers from the matched endpoint definition, if any are defined and set them on the response.
    while IFS=$'\t' read -r headerName headerValue; do

        # if header value is empty, skip setting the header on the response.
        [[ -z "$headerValue" ]] && continue

        # if header name equals "Content-Type" and the header value equals application/json then skip setting the header on the response, as this is the default content type for Mocktail Server responses.
        [[ "$headerName" == "Content-Type" && "$headerValue" == "application/json" ]] && continue   
       
        # otherwise, set the header on the response.
        SetBashletResponseHeader "$response" "$headerName" "$headerValue"

    done < <(ParseMockAPICollectionEndpointResponseHeaders "$matchedEndpoint")

}


generateResponseFromMatchedEndpoint(){
    request="$1"
    response="$2"
    matchedEndpoint="$3"

    local responseBody
    local statusCode

    # parse the response status code from the matched endpoint definition, defaulting to 200 if not defined.
    statusCode="$(ParseMockAPICollectionEndpointField "$matchedEndpoint" '.Response.StatusCode // 200')"

    # parse the response body from the matched endpoint definition, this will dictate how the response is generated.
    responseBody="$(ParseMockAPICollectionEndpointResponseBody "$matchedEndpoint")"

    # if the response body is a string is a single string equal to "ECHO" (case insensitive) then generate an echo response, 
    # the body provided in the request. Is merely echoed back as the response body.
    if [[ "${responseBody,,}" == "echo" ]]; then
        echo "MockingController: Generating dynamic response for matched endpoint." >&2
        generateEchoedResponseFromMatchedEndpoint "$request" "$response" "$matchedEndpoint"
    elif [[ "$statusCode" == "302" ]]; then
        echo "MockingController: Generating redirect response for matched endpoint." >&2
        generateRedirectResponseFromMatchedEndpoint "$request" "$response" "$matchedEndpoint"
    else
        echo "MockingController: Generating static response for matched endpoint." >&2
        generateStaticResponseFromMatchedEndpoint "$request" "$response" "$matchedEndpoint"
    fi
   
   
}


generateEchoedResponseFromMatchedEndpoint(){
    request="$1"
    response="$2"
    matchedEndpoint="$3"

    local statusCode
    local responseBody

    # first and foremost parse the request method as echo responses can only be generated for POST requests, as the 
    # request body is used to define the response body that will be returned.
    requestMethod="$(ParseMockAPICollectionEndpointField "$matchedEndpoint" '.Method')"
    if [[ "$requestMethod" != "POST" ]]; then
        echo "MockingController: Echo responses can only be generated for POST requests, but the matched endpoint is defined for method: $requestMethod" >&2
        local err_status_code=400
        local err_content="Bad Request - Echo responses can only be generated for POST requests, but the matched endpoint is defined for method: $requestMethod"
        SendBashletErrorResponse "$err_status_code" "$err_content" "$request"
        return 1
    fi

    # parse the response status code and body from the matched endpoint definition, defaulting to 200 if not defined.
    statusCode="$(ParseMockAPICollectionEndpointField "$matchedEndpoint" '.Response.StatusCode // 200')"

    # parse the request body from the request, which will be used as the response body for the echo response.
    responseBody="$(ParseBashletRequestBody "$request")"

    # set the response headers from the matched endpoint definition, if any are defined.
    setResponseHeadersFromEndpoint "$response" "$matchedEndpoint"

    # set the response status code to the value parsed from the matched endpoint definition, or 200 if not defined.
    SetBashletResponseStatusCode "$response" "$statusCode"

    # set the response body to the value parsed from the matched endpoint definition, or an empty string if not defined.
    SetBashletResponseBody "$response" "$responseBody"
}

generateStaticResponseFromMatchedEndpoint(){
    request="$1"
    response="$2"
    matchedEndpoint="$3"

    local statusCode
    local responseBody

    # parse the response status code and body from the matched endpoint definition, defaulting to 200 if not defined.
    statusCode="$(ParseMockAPICollectionEndpointField "$matchedEndpoint" '.Response.StatusCode // 200')"

    # parse the response body from the matched endpoint definition, defaults to an empty string if not defined.
    responseBody="$(ParseMockAPICollectionEndpointResponseBody "$matchedEndpoint")"

    # if dynamic parameter substitution is enabled, substitute the parameters in the response body.
    if [[ "$(ParseMockAPICollectionEndpointField "$matchedEndpoint" '.EnableDynamicParamSubstitution // false')" == "true" ]]; then
        echo "MockingController: Dynamic parameter substitution is enabled for matched endpoint, substituting parameters in response body." >&2
        responseBody="$(executeDynamicParameterSubstitution "$request" "$matchedEndpoint")"
    fi

    # set the response status code to the value parsed from the matched endpoint definition, or 200 if not defined.
    SetBashletResponseStatusCode "$response" "$statusCode"

    # set the response headers from the matched endpoint definition, if any are defined.
    setResponseHeadersFromEndpoint "$response" "$matchedEndpoint"

    # set the response body to the value parsed from the matched endpoint definition, or an empty string if not defined.
    SetBashletResponseBody "$response" "$responseBody"
}


generateRedirectResponseFromMatchedEndpoint(){
    request="$1"
    response="$2"
    matchedEndpoint="$3"

    local statusCode
    local redirectUrl

    # parse the response status code and validate that it's equal to 302, as redirect responses can only be generated 
    # for 302 status codes.
    statusCode="$(ParseMockAPICollectionEndpointField "$matchedEndpoint" '.Response.StatusCode // 302')"
    if [[ "$statusCode" != "302" ]]; then
        echo "MockingController: Redirect responses can only be generated for 302 status codes, but the matched endpoint is defined for status code: $statusCode" >&2
        local err_status_code=500
        local err_content="Internal Server Error - Redirect responses can only be generated for 302 status codes, but the matched endpoint is defined for status code: $statusCode"
        SendBashletErrorResponse "$err_status_code" "$err_content" "$request"
        return 1
    fi

    # parse the response body from the matched endpoint definition, defaults to an empty string if not defined.
    # this should contain an array of one or more redirect urls.
    responseBody="$(ParseMockAPICollectionEndpointResponseBody "$matchedEndpoint")"
    
    # if the response body is not an array, return a 400 error to the client.
    if ! IsAnArray "$responseBody"; then
        echo "MockingController: Redirect responses must be defined as an array of one or more redirect urls, but the matched endpoint is defined with a response body of type: $(GetJsonType "$responseBody")" >&2
        local err_status_code=500
        local err_content="Internal Server Error - Redirect responses must be defined as an array of one or more redirect urls, but the matched endpoint is defined with a response body of type: $(GetJsonType "$responseBody")"
        SendBashletErrorResponse "$err_status_code" "$err_content" "$request"
        return 1
    fi

    #  if the response body is an array, but it is empty, return a 500 error to the client.
    if [[ $(ArrayLength "$responseBody") -eq 0 ]]; then
        echo "MockingController: Redirect responses must be defined as an array of one or more redirect urls, but the matched endpoint is defined with an empty array." >&2
        local err_status_code=500
        local err_content="Internal Server Error - Redirect responses must be defined as an array of one or more redirect urls, but the matched endpoint is defined with an empty array."
        SendBashletErrorResponse "$err_status_code" "$err_content" "$request"
        return 1
    fi

    # convert the json array to a bash array,
    local redirectUrls
    mapfile -t redirectUrls < <(JsonArrayToLines "$responseBody")
    local arrayLength=${#redirectUrls[@]}
    if [[ $arrayLength -eq 1 ]]; then
        # if there is only one redirect url in the array, use that as the redirect url.
        redirectUrl="${redirectUrls[0]}"
    elif [[ $arrayLength -gt 1 ]]; then

        # Where there are MULTIPLE redirect URLS defined...
        # 1) Parse the incoming request query string parameters if it includes inc=[an index] then use that index to
        #    select the redirect url from the array, 
        # 2) Conversely if the query string includes exc=[an index] then exclude 
        #    that index from the array and select a random redirect url from the remaining urls.
        # 3) If neither inc nor exc are provided in the query string, then select a random redirect url from the array.       
        local incIndex=$(ParseBashletRequestQueryStringParam "$request" "inc")
        local excIndex=$(ParseBashletRequestQueryStringParam "$request" "exc")
        
        if [[ -n "$incIndex" ]]; then
            # if the inc index is provided, use that index to select the redirect url from the array, if the index is valid.
            if [[ "$incIndex" -ge 0 && "$incIndex" -lt "$arrayLength" ]]; then
                echo "MockingController: Using provided inc index '$incIndex' to select redirect url from array of length '$arrayLength'." >&2
                redirectUrl="${redirectUrls[$incIndex]}"
            else
                echo "MockingController: The provided inc index '$incIndex' is out of bounds for the redirect urls array of length '$arrayLength'." >&2
                local err_status_code=400
                local err_content="Bad Request - The provided inc index '$incIndex' is out of bounds for the redirect urls array of length '$arrayLength'."
                SendBashletErrorResponse "$err_status_code" "$err_content" "$request"
                return 1
            fi
        elif [[ -n "$excIndex" ]]; then
            # if the exc index is provided, exclude that index from the array and select a random redirect url from the remaining urls, if the index is valid.
            if [[ "$excIndex" -ge 0 && "$excIndex" -lt "$arrayLength" ]]; then
                echo "MockingController: Using provided exc index '$excIndex' to exclude redirect url from array of length '$arrayLength'." >&2
                # create a new array excluding the specified index
                local filteredRedirectUrls=()
                for i in "${!redirectUrls[@]}"; do
                    if [[ "$i" -ne "$excIndex" ]]; then
                        filteredRedirectUrls+=("${redirectUrls[$i]}")
                    fi
                done
                # select a random redirect url from the filtered array
                local filteredArrayLength=${#filteredRedirectUrls[@]}
                if [[ $filteredArrayLength -eq 0 ]]; then
                    echo "MockingController: The provided exc index '$excIndex' excludes all redirect urls from the array, resulting in an empty array." >&2
                    local err_status_code=400
                    local err_content="Bad Request - The provided exc index '$excIndex' excludes all redirect urls from the array, resulting in an empty array."
                    SendBashletErrorResponse "$err_status_code" "$err_content" "$request"
                    return 1
                fi
                redirectUrl="${filteredRedirectUrls[RANDOM % $filteredArrayLength]}"
            else
                echo "MockingController: The provided exc index '$excIndex' is out of bounds for the redirect urls array of length '$arrayLength'." >&2
                local err_status_code=400
                local err_content="Bad Request - The provided exc index '$excIndex' is out of bounds for the redirect urls array of length '$arrayLength'."
                SendBashletErrorResponse "$err_status_code" "$err_content" "$request"
                return 1
            fi
        else
            # if neither inc nor exc are provided, select a random redirect url from the array.
            echo "MockingController: No inc or exc index provided, selecting a random redirect url from array of length '$arrayLength'." >&2
            redirectUrl="${redirectUrls[RANDOM % $arrayLength]}"
        fi
    else
        echo "MockingController: Redirect responses must be defined as an array of one or more redirect urls, but the matched endpoint is defined with an empty array." >&2
        local err_status_code=500
        local err_content="Internal Server Error - Redirect responses must be defined as an array of one or more redirect urls, but the matched endpoint is defined with an empty array."       
        SendBashletErrorResponse "$err_status_code" "$err_content" "$request"
        return 1
    fi


    # set the response status code to the value parsed from the matched endpoint definition, guartenteed to be 302 at this point.
    SetBashletResponseStatusCode "$response" "$statusCode"

    # set the response headers from the matched endpoint definition, if any are defined.
    setResponseHeadersFromEndpoint "$response" "$matchedEndpoint"

    # finally dispatch a redirect response to the client, the helper function will implicitly
    # set the Location header to the redirect url and return a 302 response to the client.
    # We can optionally provide reference to the response object to have any headers or other state
    # set on the response object to be included in the redirect response.
    DispatchBashletRedirectResponse "$redirectUrl" "$response" 


}

# maps the query string parameters in the inbound request to the response body of the matched endpoint, where the response body 
# is defined as an object. This allows the value of attributes in the response body JSON to be dynamically set. Where specified,
# the values provided as request query string parameters will override the corresponding values defined in the matched endpoint 
# response body providing the name of the query string parameter matches the name of the attribute in the response body JSON.
executeDynamicParameterSubstitution(){
    request="$1"
    matchedEndpoint="$2"


    # parse the endpoint body from the matched endpoint definition, which will be used to map the request parameters to.
    endpointBody="$(ParseMockAPICollectionEndpointResponseBody "$matchedEndpoint")"

    # if the endpoint body is not an object, return a 400 error to the client.
    if ! IsAnObject "$endpointBody"; then
        echo "MockingController: Endpoint body must be defined as an object, but the matched endpoint is defined with a body of type: $(GetJsonType "$endpointBody")" >&2
        local err_status_code=500
        local err_content="Internal Server Error - Endpoint body must be defined as an object, but the matched endpoint is defined with a body of type: $(GetJsonType "$endpointBody")"
        SendBashletErrorResponse "$err_status_code" "$err_content" "$request"
        return 1
    fi

    # next iterate over the parameters in the endpoint body and check if there is a corresponding query string parameter in the request, if so, override the value in the endpoint body with the value from the request parameter.
    while IFS=$'\t' read -r key value; do
        # check if the request has a query string parameter with the same name as the key in the endpoint body, if so, override the value in the endpoint body with the value from the request parameter.
        requestParamValue="$(ParseBashletRequestQueryStringParam "$request" "$key")"
        if [[ -n "$requestParamValue" ]]; then
            echo "MockingController: Overriding endpoint body attribute '$key' with value from request parameter: $requestParamValue" >&2
            endpointBody="$(SetMockAPICollectionField "$endpointBody" ".$key" "$requestParamValue")"
        fi
    done < <(ParseMockAPICollectionField "$endpointBody" 'to_entries[] | "\(.key)\t\(.value)"') 

    # return the modified endpoint body, which will be used as the response body for the matched endpoint.  
    echo "$endpointBody"


} 
#Generates a collection id from the provided name by converting it to lowercase, replacing spaces with hyphens, 
#and removing any non-alphanumeric characters except hyphens. 
generateCollectionIdFromName(){ 
    collectionName="$1"

    # convert the collection name to lowercase, replace spaces with hyphens, and remove any non-alphanumeric characters except hyphens.
    collectionId="$(echo "$collectionName" | tr '[:upper:]' '[:lower:]' | sed 's/ /-/g' | sed 's/[^a-z0-9-]//g')"

    echo "$collectionId"
}




