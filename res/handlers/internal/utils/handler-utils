# handles SubHandler type route requests by delgating to the specified sub-handler script defined in the route info, 
# where the route type is unsupported or no valid script is provided an appropriate error response will be generated 
# and returned to the client.
handleSubHandlerRouteRequest() {
  echo "handler-utils: Handling request for path: $path according to SubHandler route type..." >&2
  local route_info="$1"
  local request_path="$2"
  local request_method="$3"
  local request_protocol="$4"
  local request_json_object="$5"

  local route_type=$(parseRouteType "$route_info")
  local route_path=$(parseRoutePath "$route_info")
  local route_sub_handler_script="$(parseSubHandlerRouteScript "$route_info")"

  # ensure the route type is of type sub handler and a sub handler script path has been specified.
  if [[ "$route_type" == "sub-handler" && -n "$route_sub_handler_script" ]]; then
    route_sub_handler_script="${route_sub_handler_script#/}"  # parse the relative sub-handler script path from the config, ensuring we remove any leading slash to avoid issues when constructing the full path.
    route_sub_handler_script="${SCRIPT_DIR}/${route_sub_handler_script}" # construct the full path to the sub-handler script by combining the basescript directory path with the relative path from the config.
    echo "root-handler: Routing to sub-handler script: $route_sub_handler_script for path: $request_path" >&2
    
    # before delegating to the sub-handler script we need to strip the matched prefix from the path, this is because the sub-handlers will 
    # expect paths to be relative to their own defined route path, for example if we have a route with the path "/usr" and a request comes in 
    # for "/usr/profile", when we delegate to the sub-handler we want to pass it "profile" as the path rather than "/usr/profile", 
    # this allows the sub-handler to be more flexible and reusable as it can be mounted at different base paths without needing to 
    # worry about adjusting the paths it receives.
    local stripped_request_path=$(stripPrefixFromPath "$request_path" "$route_path")
    "$route_sub_handler_script" "$request_path" "$request_method" "$request_protocol" "/$stripped_request_path" "$request_json_object"
    return $?
  else
    echo "handler-utils: Unsupported route type: $route_type or script definition for SubHandler route type associated with path: $request_path, sending default response." >&2
    DispatchErrorResponse 500 "Unsupported route type: $route_type for path: $request_path" "application/json" "$request_path" "$request_method" "$request_json_object"
  fi
}



# handles Static type route requests by reading the specified static resource from the file system and 
#returning its contents in the response body, where the route type is unsupported or no valid file path is provided 
#an appropriate error response will be generated and returned to the client.
handleStaticRouteRequest() {
  echo "handler-utils: Handling request for path: $path according to Static route type..." >&2

  # for static routes we will have a path to a static resource i.e. file, defined in the config
  # we parse those details here then attempt to read the file into memory and return its contents
  # in the response body, we also set the content type based on the file extension, defaulting to 
  # application/json if we cannot determine a specific type.
  local route_info="$1"
  local request_path="$2"
  local request_method="$3"
  local request_protocol="$4"
  local request_json_object="$5"



  local route_path=$(parseRoutePath "$route_info")
  local route_type=$(parseRouteType "$route_info")
  local route_file_path="$(parseStaticRouteFilePath "$route_info")"
  if [[ "$route_type" == "static" && -n "$route_file_path" ]]; then 
    
    # echo "&&&********* Called by: ${BASH_SOURCE[2]}" >&2
    # what we do next will depend on whether this is a wildcard static route or not as denoted
    # by a route Path that is suffixed with a wildcard i.e "*" character
    absolute_file_path=""
    if [[ "$route_path" == *"*" ]]; then
     
        echo "handler-utils: Handling request for wildcard static route, stripping wildcard character AND trailing slash (if it exists) from route path..." >&2
        
        # we need to strip the wildcard character from the end of the route path, we also want to ensure we strip any trailing slash that may be left after removing 
        # the wildcard character as this will interfere with our path resolution logic later on.
        route_path="${route_path%\*}" 
        route_path="${route_path%/}"

        # build up the absolute file path by stripping the route prefix from the
        # request path and joining that remainder with the configured FilePath.
        # e.g. route Path: /assets/*, request_path: /assets/modules/x.css
        # remainder => modules/x.css, final => [SCRIPT_DIR]/[FilePath]/modules/x.css
        local stripped_request_path
        stripped_request_path=$(stripPrefixFromPath "$request_path" "$route_path")

        # Use realpath -m to normalize duplicate slashes and path segments
        if command -v realpath >/dev/null 2>&1; then
          absolute_file_path=$(realpath -m "${SCRIPT_DIR}/${route_file_path#/}/${stripped_request_path#/}")
        else
          # Fallback: manually strip trailing slash from base and join
          base="${route_file_path#/}"
          base="${base%/}"
          if [[ -n "$stripped_request_path" ]]; then
            absolute_file_path="${SCRIPT_DIR}/${base}/${stripped_request_path#/}"
          else
            absolute_file_path="${SCRIPT_DIR}/${base}"
          fi
        fi
        echo "handler-utils: final file path for static (wildcard) route is: $absolute_file_path" >&2

    else
      echo "handler-utils: Handling request for non-wildcard static route..." >&2  
      # build up absilute path to the file by concatenting the base script directory with the file path defined in the config for this route, this will allow us to correctly resolve the file on disk that corresponds to the request.
      absolute_file_path="${SCRIPT_DIR}/${route_file_path#/}"
      echo "handler-utils: final file path for static route is: $absolute_file_path" >&2
    fi


    # next, irrespective of how we derive the path to file, we validate that the final file path exists on the system before proceeding.
    if [[ -f "$absolute_file_path" ]]; then
      echo "handler-utils: Successfully found static resource for path: $path at file path: $route_file_path" >&2

      # Determine MIME type from filename and stream the file to the client
      local content_type
      content_type=$(getMimeType "$absolute_file_path")
      dispatchFileResponse "$absolute_file_path" "$content_type"

    echo "handler-utils: Static resource response sent for path: $path, closing connection." >&2
    elif [[ -d "$absolute_file_path" ]]; then
      
      #echo "absolute_file_path: $absolute_file_path, script file path: $SCRIPT_DIR" >> log.txt

      echo "handler-utils: Static resource path is a directory for path: $path at file path: $route_file_path, looking for default index file..." >&2
      # Check if there's an index.html file in the directory
      if [[ -f "$absolute_file_path/index.html" ]]; then
        dispatchFileResponse "$absolute_file_path/index.html" "text/html"
        echo "handler-utils: Static resource response sent for path: $path, found index.html, closing connection." >&2
      #final check: if the provided path is the server www root and no index.html exist we return the default mocktail welcome page to the client.
      elif [[ "$absolute_file_path" == "/home/gilesthompson/erudite/shareful-oss/shareful-utils-mocktail/res/usr/www" ]]; then
        dispatchFileResponse "${SCRIPT_DIR}/res/handlers/internal/xmocktail-welcome-page.html" "text/html"
        echo "handler-utils: Static resource response sent for path: $path, found index.htm, closing connection." >&2
      else
        DispatchErrorResponse 404 "The provided path references a directory that DOES NOT contain an index.html file" "application/json" "$request_path" "$request_method" "$request_json_object"
      fi
    else
      echo "handler-utils: Static resource file not found for path: $path at file path: $route_file_path, the absolute file path was: $absolute_file_path, sending error response." >&2
      DispatchErrorResponse 404 "The requested resource was not found" "application/json" "$request_path" "$request_method" "$request_json_object"
    fi
  else
    echo "handler-utils: Unsupported route type: $route_type or file path definition for Static route type associated with path: $path, sending error response." >&2
    DispatchErrorResponse 500 "Unsupported route type: $route_type or file path definition for Static route type associated with path: $path" "application/json" "$request_path" "$request_method" "$request_json_object"
  fi    
  
}

handleBashletRouteRequest() {
  echo "handler-utils: Handling request for path: $path according to Bashlet route type..." >&2
  local route_info="$1"
  local request_path="$2"
  local request_method="$3"
  local request_protocol="$4"
  local request_json_object="$5"


  local route_type=$(parseRouteType "$route_info")
  local route_path=$(parseRoutePath "$route_info")

  # ensure the route type is of type bashlet and a request object has been provided.
  if [[ "$route_type" == "bashlet" && -n "$request_json_object" ]]; then

    echo "handler-utils: Routing to Bashlet Engine for path: $request_path" >&2

    # delegate to the BashletEngine to handle the request, passing in the request object as a parameter.
    DelegateRequestToBashletEngine "$route_path" "$request_json_object" "$request_path"
  else
    echo "handler-utils: Unsupported route type: $route_type or missing request object for Bashlet route type associated with path: $request_path, sending error response." >&2
    DispatchErrorResponse 500 "Unsupported route type: $route_type for path: $request_path" "application/json" "$request_path" "$request_method" "$request_json_object"
  fi    

}

