{
  "Name": "Example Mock API (Basic)",
  "Description": "Example that demonstrates the use of Mocktail Server to create a simple Mock API with endpoints that return static JSON responses.",
  "Version": "1.0",
  "CollectionId": "x101",
  "Type":"System",
  "Endpoints": [
    {
      "Path": "/api/v1/users",
      "Method": "GET",
      "Response": {
        "Body": 
          [
            {
              "id": 1,
              "name": "John Doe",
              "email": "john.doe@example.com"
            },
            {
              "id": 2,
              "name": "Jane Smith",
              "email": "jane.smith@example.com"
            }
          ]
      }
    },
    {
      "Path": "/api/v1/users/settings",
      "Method": "GET",
      "Response": {
        "Body": 
            {
              "Enable2FA": true,
              "EnableMailNotifications": false,
              "EnableUserGeolocation": true
            }  
      }
    },
    {
      "Path": "/api/v1/users/{userId}",
      "Method": "GET",
      "Response": {
        "Body": 
          
            {
              "id": 1,
              "name": "John Doe",
              "email": "john.doe@example.com"
            }
          
      }
    },
    {
      "Path": "/api/v1/users/{userId}/addresses/{addressId}",
      "Method": "GET",
      "Response": {
        "Body": 
          
            {
              "Street": "123 Main St",
              "City": "Anytown",
              "State": "CA",
              "ZipCode": "12345"
            }
          
      }
    }
    

  ]
}