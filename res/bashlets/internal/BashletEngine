#!/bin/bash

Log "INFO" "BashletEngine: Loaded BashletEngine component.."

# source the bashlet-utils script, which provides utility functions for bashlet operations, including parsing request objects and other common tasks.
source "${SCRIPT_DIR}/res/bashlets/internal/BashletContext"

# source the config helpers so secure-route auth checks can read the stored passphrase before any specific bashlet is invoked.
source "${SCRIPT_DIR}/res/handlers/internal/utils/config-utils"

# the file extension for bashlet scripts, which is used to identify them during the resolution process.
BASHLET_FILE_EXT=".shh" 

# array of route configs (at well-known usr and system paths) that may have one or more bashlet routes defined.
ROUTE_CONFIGS=("${SCRIPT_DIR}/res/handlers/sys/system-handler-routes.json" "${SCRIPT_DIR}/res/handlers/usr/user-handler-routes.json")

# an associative array to map route paths to their corresponding bashlet script paths, 
# which will be populated during the resolution process.
declare -A ROUTE_PATH_TO_BASHLET_PATH=()

# stores route metadata for all bashlets (as a JSON object) which is populated on initialisation of the component
# via a call to the parseAllBashletAnnotationMetadata function, which parses all bashlet scripts for route annotations.
BASHLET_ANNOTATION_METADATA=""

           






# initialises the BashletEngine, this must be called before attempting to use any other f
# public facing functions the BashletEngine exports.
InitBashletEngine() {

    Log "INFO" "BashletEngine: Initializing Bashlet Engine..."

  # resolve bashlets from the route configs, which will populate the ROUTE_PATH_TO_BASHLET_PATH associative array.
  resolveBashletsFromRouteConfigs

  # next parse the all internal bashlet annotations for route metadata, which will allow the engine 
  # to understand how to route inbound request to the appropriate bashlet function based on the route path and method.
  BASHLET_ANNOTATION_METADATA="$(parseAllBashletAnnotationMetadata)"

  # crucially export the BASHLET_ANNOTATION_METADATA and ROUTE_PATH_TO_BASHLET_PATH variables so that 
  # they are available to sub bash processes spawned by the Mocktail server (i.e. socat under the hood)
  exportVariablesForSubProcessesAsBase64


  #echo "$BASHLET_ANNOTATION_METADATA" >&2
  
}



DelegateRequestToBashletEngine() {

    Log "INFO" "BashletEngine: Delegating request to bashlet..."
  
    # obtain references to the route path and request object passed in as arguments.
    local route_path="$1"
    local bashletRequest="$2"
    local relative_request_path="$3"

    # import pre-parsed metadata from parent to reconstruct associative arrays
    importVariablesFromParentProcess

    # This error should really only occur where the user has failed to specify a path to the target bashlet 
    # in the route config. Its critical to note that the path itself IS NOT checked here (we'll do that next), 
    # rather this check just determines if a non-zero path to a bashlet has been specified.
    # This is really a server configuration issue and thus we return a 500 error.
    if [[ -z "${ROUTE_PATH_TO_BASHLET_PATH_FROM_PARENT_PROC[$route_path]}" ]]; then
        Log "ERROR" "BashletEngine: A non-existent or invalid bashlet path was specified for route: $route_path"

        local err_status_code=500
        local err_content="A non-existent or invalid bashlet path was specified for route: $route_path"
        SendBashletErrorResponse "$err_status_code" "$err_content" "$bashletRequest"
        return 1
    fi

    local bashlet_path="${ROUTE_PATH_TO_BASHLET_PATH_FROM_PARENT_PROC[$route_path]}"
    local absolute_bashlet_file_path="${SCRIPT_DIR}/${bashlet_path#/}${BASHLET_FILE_EXT}"

    # satisfied that we have a path, next we check if the path is valid, where its not we
    # return a 404 error to the client to indicate that the specified bashlet could not be found. 
    if [[ ! -f "$absolute_bashlet_file_path" || ! -r "$absolute_bashlet_file_path" ]]; then
        Log "ERROR" "BashletEngine: Bashlet file not found or is unreadable: $absolute_bashlet_file_path"
        
        local err_status_code=404
        local err_content="Bashlet file not found or is unreadable: $absolute_bashlet_file_path"
        SendBashletErrorResponse "$err_status_code" "$err_content" "$bashletRequest"
        return 1
    fi
        

    Log "INFO" "BashletEngine: Delegating request to bashlet: $absolute_bashlet_file_path"

    # Source the bashlet file to make its functions available in the current shell context
    # shellcheck source=/dev/null
    source "$absolute_bashlet_file_path"

    # normalize the (relative) request path to ensure consistent routing behavior, removing any query strings and trailing slashes (except for root).
    request_path="$(normalizeRequestPath "$relative_request_path")"

    # strip the bashlet route prefix from the request path to obtain the relative path that will be passed to the bashlet function.
    sanitized_request_path="$(StripPrefixFromBashletPath "$request_path" "$route_path")"

    # ensure the request path always begins with a leading slash since bashlet functions will always 
    # specify relative to the containing bashlets route path.
    sanitized_request_path="$(EnsureLeadingSlash "$sanitized_request_path")"

    Log "INFO" "bashlet engine: final targtet bashlet function path: $sanitized_request_path"

    # parse the request method from the request object
    request_method="$(ParseBashletRequestMethod "$bashletRequest")"

    Log "INFO" "bashlet engine: final targtet bashlet function method: $request_method"

    # var to hold target route parsed from the bashlet annotation metadata.
    local route_metadata

    # crucially, next we attempt to resolve the route metadata for the specified path (where it exists) the route metadata
    # is derived from the bashlet handler function annotations which are parsed and stored in the BASHLET_ANNOTATION_METADATA variable 
    # during the initialisation of the BashletEngine.
    route_metadata="$(
        jq -c \
            --arg file "$absolute_bashlet_file_path" \
            --arg path "$sanitized_request_path" \
            --arg method "$request_method" '

                        def normPath:
                                tostring
                                | if . == "" then "/" else . end
                                | if startswith("/") then . else "/" + . end
                                | if . == "/" then . else sub("/+$"; "") end;

                        def pathSegments:
                                normPath
                                | if . == "/" then [] else ltrimstr("/") | split("/") end;

                        def isParamSegment:
                                test("^\\{[^/]+\\}$");

                        def matchesTemplate($path; $templatePath):
                                ($templatePath | pathSegments) as $templateSegments
                                | ($path | pathSegments) as $requestSegments
                                | ($templateSegments | length) == ($requestSegments | length)
                                    and all(range(0; ($templateSegments | length));
                                        ($templateSegments[.] | isParamSegment) or ($templateSegments[.] == $requestSegments[.])
                                    );
                
            (.bashlets // .Bashlets // [])[]
            | select(.BashletFilePath == $file)

            | [
                .BashletRoutes[]

                                | .Path as $route

                                | ($route | normPath) as $normalizedPath

                | (.Method // .method // "") as $route_method

                                | . + {
                                        __normalizedPath: $normalizedPath,
                                        __isParamPath: ($normalizedPath | pathSegments | any(isParamSegment)),
                                        __segmentCount: ($normalizedPath | pathSegments | length),
                                        __paramCount: ($normalizedPath | pathSegments | map(select(isParamSegment)) | length)
                                    }

                | select(
                                        ( ($route_method == "") or ( ($route_method | ascii_downcase) == ($method | ascii_downcase) ) )
                                        and (
                                ((.__isParamPath | not) and (.__normalizedPath == $path))
                                                or
                                (.__isParamPath and matchesTemplate($path; .__normalizedPath))
                                or
                                (.__normalizedPath == "/")
                                        )
                )

              ]

                        | (
                                ([ .[] | select((.__isParamPath | not) and (.__normalizedPath == $path)) ] | .[0])
                                //
                                ([
                                        .[]
                                        | select(.__isParamPath)
                                        | select(matchesTemplate($path; .__normalizedPath))
                                    ]
                             | max_by([.__segmentCount, (-(.__paramCount))]))
                            //
                            ([ .[] | select((.__normalizedPath == "/") and ((.Method // .method // "") | ascii_downcase == ($method | ascii_downcase))) ] | .[0])
                            ) // empty

            ' <<< "$BASHLET_ANNOTATION_METADATA_FROM_PARENT_PROC"
    )"

    Log "INFO" "ROUTE DATA IS: $route_metadata"

    # if no route metadata was found for the specified request path, we return a 404 error to the client 
    # to indicate that no function route in the bashlet matched the request path.
    if [[ -z "$route_metadata" ]]; then
        Log "ERROR" "BashletEngine: No function route in bashlet '$absolute_bashlet_file_path' matched request path '$sanitized_request_path'"
        
        local err_status_code=404
        local err_content="No handler function route in Bashlet: $absolute_bashlet_file_path matched request path: $sanitized_request_path for method: $request_method"
        SendBashletErrorResponse "$err_status_code" "$err_content" "$bashletRequest"
        return 1
        
    fi

    # firstly ascertain if the route is marked as secure if so and the user has not been authenticated we redirect the 
    # user to the main system signin page, the path to the resource they was attempting to access is passed as a query parameter 
    # to the signin page so that they can be redirected back to it after successful authentication.
    if [[ "$(jq -r '.Secure // false' <<< "$route_metadata")" == "true" ]]; then

        Log "INFO" "BashletEngine: Route is marked as secure, checking if user has authenticated on the server..."


        # check if the user is authenticated by checking for the presence of the auth cookie in the request object.
        authCookie="$(GetCookieInBashletRequest "$bashletRequest" "$AUTH_TOKEN_COOKIE_NAME")"

      
        # where an auth cookie exists we check thats its valid, we'll need the stored passphrase from
        # the config file to do this, where the passphrase is not found an empty string will be returned
        # and the check will subsequently fail, thus we don't need to explicitly check for the passphrase here, 
        # we just check if the auth cookie is valid.
        storedPassphrase="$(GetStoredPassphraseFromConfig)"

        CheckAuthSessionToken "$authCookie" "$storedPassphrase"
        authCookieValid="$?"

        # if the auth cookoie does not exist or is invalid we redirect the user to the signin page, 
        # passing the original request path as a query parameter for redirection after successful signin.
        if [[ -z "$authCookie" ]] || [[ "$authCookieValid" -eq 1 ]]; then
            Log "INFO" "BashletEngine: Received request to secure route: $sanitized_request_path, but user is not currently authenticated, redirecting to signin page..."

            # Build up the signin success path, this is the location we will redirect the user to after successful signin, which is the original request path they were attempting to access.
            # NOTE: The signin success path MUST be absolute as the redirect will be peformed by the browser as a brand new request.
            absoluteSigninSuccessRedirectPath="$(realpath -m "/sys/$relative_request_path")"
            absoluteSigninSuccessRedirectPath="$(UrlEncode "$absoluteSigninSuccessRedirectPath")"
            
            # build warning message acording to whether or not the user had a prior valid session
            # that has now expired.
            local warningMessageVal
            if  [[ -n "$authCookie" ]]  &&  [[ "$authCookieValid" -eq 1 ]]; then
                warningMessageVal="$(UrlEncode "Your session has expired, please sign in again to access the requested resource.")"
            else
                warningMessageVal="$(UrlEncode "You must be logged in to access the requested resource.")"
            fi

            # build the redirect URL to the signin page, including the original request path as a 
            # query parameter for redirection after successful signin. We also  include a warning
            # message to indicate to the user that they must sign in to access the requested resource.
            local redirect_url="/sys/signin?redirect=$absoluteSigninSuccessRedirectPath&warningMessage=$warningMessageVal"

            # redirect the user to the signin page.
            DispatchBashletRedirectResponse "$redirect_url"
            return 1
        fi
    fi

    # parse the function name from the JSON route metadata.
    local func_name
    func_name="$(jq -r '.Function // empty' <<< "$route_metadata")"

    # if no function name was found in the route metadata, we return a 500 error to the client 
    # to indicate that the bashlet is misconfigured and cannot be invoked.
    if [[ -z "$func_name" ]]; then
        Log "ERROR" "BashletEngine: No function name found in route metadata."

        local err_status_code=500
        local err_content="No function name found in route configuration for bashlet '$absolute_bashlet_file_path'"
        SendBashletErrorResponse "$err_status_code" "$err_content" "$bashletRequest"
        return 1
    fi

    # check if the function exists in the current shell context, where it does not we return a 500 error to the client
    # to indicate that the bashlet is misconfigured and cannot be invoked.
    if [[ "$(type -t "$func_name")" != "function" ]]; then
        Log "ERROR" "BashletEngine: Function '$func_name' not found in bashlet '$absolute_bashlet_file_path'"

        local err_status_code=500
        local err_content="Function '$func_name' not found in bashlet '$absolute_bashlet_file_path'"
        SendBashletErrorResponse "$err_status_code" "$err_content" "$bashletRequest"
        return 1
    fi

    # otherwise where the bashlet route config is correct and the function exists, we can now invoke 
    # the bashlet function, passing in the request object and a default response object. 
    Log "INFO" "BashletEngine: Resolved '$sanitized_request_path' -> '$func_name'"

    # store the route-relative path separately so existing callers can still access the mounted URL via .path,
    # while path helpers operate against the matched bashlet subpath.
    bashletRequest="$(SetJSONField "$bashletRequest" '.rel_path' "$sanitized_request_path")"

    # extract any path parameters from the inbound request and add them to the request object
    # as name value pairs under the name bashlet_path_params since path params will only be supported in bashlets
    local path_params
    path_params=$(ExtractPathParametersFromRequest "$bashletRequest" "$route_metadata")
    bashletRequest=$(SetJSONField "$bashletRequest" '.bashlet_path_params' "$path_params")

    # build default response object to be returned to the caller, which may be optionally augmented by the
    # bashlet function being invoked, where its not, this default success response will be returned.
    bashletResponse="$(BuildDefaultBashletResponseObject 200 '{}' 'text/plain' '')"    
    bashletResponseVarName="bashletResponse" # name of the response object variable to pass to the bash

    # call init on the bashlet if this is the very first time it's being loaded AND an init function has been defined
    # in the bashlet, this allows the bashlet to perform any necessary initialisation tasks before handling requests.
    # where this is not the first time the bashlet has been loaded, or no init function is defined, then the 
    # call to this function will be a no-op.
    initialiseBashlet "$absolute_bashlet_file_path"
    

    # crucially we may now invoke the resolved bashlet function, passing in the request object and the response object, which may 
    # be optionally modified by the bashlet function to return a custom response to the caller.
    # NB: we only pass in the NAME of the response objecrt variable which will serve as a handle, of sorts,
    # to enable the callee to load the response as a namedref and augment it as necesary.
    "$func_name" "$bashletRequest" "$bashletResponseVarName"

    # firstly ensure that a response has not already been returned to the client as indicated by the presence of the 
    # X-Request-Completed header in the response object, where it has we log this and return early.
    local xRequestCompletedHeader
    xRequestCompletedHeader="$(ParseBashletResponseHeader "$bashletResponse" 'X-Request-Completed')"
        if [[ -n "$xRequestCompletedHeader" ]]; then
        Log "INFO" "BashletEngine: Request has already been completed by the bashlet function, no further response will be sent to the client."
        return 0
    fi
    

    # before attempting to dispatch a response we check for the existence of the X-FORWARD-TO header in the request
    # if it exists then this indicates that the user, in their bashlet handler function, has requested that the request 
    # be forwarded to another route for further processing, thus we will not dispatch a response to the client here.
    xForwardToHeader="$(ParseBashletRequestHeader "$bashletRequest" 'X-Forward-To')"
    if [[ -z "$xForwardToHeader" ]]; then

       # where the X-FORWARD-TO header does not exist, we can safely dispatch the response object to the caller.
    Log "INFO" "BashletEngine: Dispatching response to client..."
       # dispatch the response object to the caller, which may have been modified by the bashlet function invoked.
       if [[ $request_method == "HEAD" ]]; then
           # For HEAD requests, we should not return a body, so we clear the body in the response object.
           SetBashletResponseBody "$bashletResponseVarName" ""
       fi
           
       # if the response body wasn't set we send one of two default success responses...
       if [[ -z "$(ParseJSONField "$bashletResponse" '.body')" ]]; then

           Log "INFO" "BashletEngine: Response body was not set by bashlet handler function, sending default success response..."

           if requestAcceptsHtml "$bashletRequest"; then
               ForwardBashletRequest "/sys/ui/success-200-default.html"
               DoForwardBashletRequest
           else
               
               # grab request host we'll need it to create the "more info" link 
               reqHost="$(ParseBashletRequestHeader "$bashletRequest" 'Host')"
               fullLink="$reqHost/sys/ui/response-body-setup-guide.html"

               # build up the defzult success response message body.
               defaultSuccessMsg="{}"
               defaultSuccessMsg="$(SetJSONString "$defaultSuccessMsg" '.status' 'success')"
               defaultSuccessMsg="$(SetJSONField  "$defaultSuccessMsg" '.message' 'This is the default Mocktail Bashlet success response, which is returned when a Mocktail Bashlet handler function does not explicitly set a response body. You can set a custom response body in your bashlet handler function by calling the built in SetBashletResponseBody() utility function with the body content. For more more info on how to do this please visit the link below, in your browser of choice.')"
               defaultSuccessMsg="$(SetJSONString "$defaultSuccessMsg" '.moreInfo' "$fullLink")"
               
               # set default response body.
               SetBashletResponseBody "$bashletResponseVarName" "$defaultSuccessMsg"

               # dispatch the default success response to the client.
               DispatchBashletResponse "$bashletResponse"
           fi
       else
               Log "INFO" "BashletEngine: Response body was set by bashlet handler function."
            DispatchBashletResponse "$bashletResponse"
       fi
      
    else
       # where the X-FORWARD-TO header exists, we do not dispatch a response to the client, instead we log that the request is being forwarded.
    Log "INFO" "BashletEngine: Request is being forwarded to: $xForwardToHeader"
       DoForwardBashletRequest
    fi

   
   
}





#---------------------------------------------------- PRIVATE HELPER FUNCTIONS --------------------------------------------#



# resolveBashletsFromRouteConfigs - resolves bashlets from the route configs and populates the ROUTE_PATH_TO_BASHLET_PATH associative array.
resolveBashletsFromRouteConfigs(){

    Log "INFO" "BashletEngine: Resolving bashlets from route configs..."

  # iterate over the array of route config paths, checking for existence and readability, and if so, parse the JSON to extract any bashlet routes defined.
  for config_path in "${ROUTE_CONFIGS[@]}"; do

    if [[ -f "$config_path" && -r "$config_path" ]]; then
    
    Log "INFO" "BashletEngine: Parsing route config: $config_path"
      # parse the JSON to extract bashlet routes (assuming a specific structure) and store them in an associative array or similar structure for later use.
      # This is a placeholder for actual JSON parsing logic, which may involve jq or similar tools.
      # Example: bashlet_routes=$(jq '.routes[] | select(.type == "bashlet")' "$config_path")
      # Use process substitution instead of piping into while to avoid a subshell
      # so assignments to the associative array persist in this shell.
      while IFS=$'\t' read -r route_path bashlet_path; do
        Log "INFO" "BashletEngine: Found bashlet route: $route_path -> $bashlet_path"
        ROUTE_PATH_TO_BASHLET_PATH["$route_path"]="$bashlet_path"
      done < <(jq -r '
        (.routes // .Routes // [])[]
        | select((.Type // .type) == "bashlet")
        | [(.Path // .path), (.BashletPath // .bashletPath)]
        | @tsv
      ' "$config_path")


        else
            Log "ERROR" "BashletEngine: Route config not found or not readable: $config_path"
    fi
  done

    Log "INFO" "BashletEngine: Bashlet resolution complete."

}


# parseAllBashletAnnotationMetadata - parses all bashlet scripts for route annotations and returns a JSON object containing the metadata.
parseAllBashletAnnotationMetadata() {

    local bashlet_objects=()

    for route_path in "${!ROUTE_PATH_TO_BASHLET_PATH[@]}"; do

        bashlet_path="${ROUTE_PATH_TO_BASHLET_PATH[$route_path]}"
        absolute_bashlet_file_path="${SCRIPT_DIR}/${bashlet_path#/}${BASHLET_FILE_EXT}"

        if [[ -f "$absolute_bashlet_file_path" ]]; then

            bashlet_objects+=(
                "$(parseBashletAnnotationMetadata "$absolute_bashlet_file_path")"
            )
        fi
    done

    if ((${#bashlet_objects[@]})); then
        printf '%s
' "${bashlet_objects[@]}" | jq -s '{Bashlets: .}'
    else
        jq -n '{Bashlets: []}'
    fi

}


# parseBashletAnnotationMetadata - parses a single bashlet script for route annotations and returns a JSON object containing the metadata.
parseBashletAnnotationMetadata() {
    local file="$1"

    declare -A route_meta=()
    local line

    local route_objects=()

    while IFS= read -r line; do

        # Route annotation - support either "# @route key=val ..." or "# key=val ..."
        if [[ "$line" =~ ^[[:space:]]*#[[:space:]]*@route[[:space:]]+(.+)$ ]]; then
      
            route_meta=()
            local params="${BASH_REMATCH[1]}"
        else
            params=""
        fi

        if [[ -n "$params" ]]; then
            Log "INFO" "BashletEngine: Found annotation params: $params"
            local token
            for token in $params; do
                local key="${token%%=*}"
                local value="${token#*=}"
                route_meta["$key"]="$value"
            done
            continue
        fi

        if [[ "$line" =~ ^([a-zA-Z_][a-zA-Z0-9_]*)[[:space:]]*\(\)[[:space:]]*\{ ]]; then

            local func_name="${BASH_REMATCH[1]}"

            if [[ -n "${route_meta[method]}" ]]; then

                local secure=false

                case "${route_meta[secure],,}" in
                    true|yes|1)
                        secure=true
                        ;;
                esac

                route_objects+=(
                    "$(
                        jq -c -n \
                            --arg func_name "$func_name" \
                            --arg method "${route_meta[method]}" \
                            --arg path "${route_meta[path]}" \
                            --argjson secure "$secure" \
                            '{
                                Function: $func_name,
                                Method: $method,
                                Path: $path,
                                Secure: $secure
                            }'
                    )"
                )

                route_meta=()
            fi
        fi

    done < "$file"

    if ((${#route_objects[@]})); then
        printf '%s\n' "${route_objects[@]}"
    else
        printf ''
    fi |
    jq -s \
        --arg filepath "$file" \
        '{
            BashletFilePath: $filepath,
            BashletRoutes: .
        }'
}




# normalises request paths by removing query strings and trailing slashes (except for root), 
# ensuring consistent routing behavior.
#
# Normalise:
#
#   /api/login
#   /api/login/
#   /api/login?a=1
#
# all become:
#
#   /api/login
#
normalizeRequestPath() {
    local path="$1"

    # Remove query string
    path="${path%%\?*}"

    # Remove trailing slash except root
    if [[ "$path" != "/" ]]; then
        path="${path%/}"
    fi

    echo "$path"
}


initialiseBashlet() {
    local bashlet_file_path="$1"

    # Check if the bashlet has already been initialized we do this by consulting the BashletEngine's
    # key-value store of initialized bashlets.
    if  KVExists "$bashlet_file_path"; then
        Log "INFO" "BashletEngine: Bashlet '$bashlet_file_path' has already been loaded, skipping init."
        return 0
    else
        Log "INFO" "BashletEngine: Bashlet '$bashlet_file_path' has not been initialized, proceeding with init."
        KVStore "$bashlet_file_path" 1  # Mark as initialized in the key-value store
    
        # Check if the init function exists in the bashlet, if so we invoke it to perform any application-specific 
        # initialisation tasks, otherwise we log that no init function was found.
        if ( source "$bashlet_file_path"; declare -F init > /dev/null ); then
            Log "INFO" "BashletEngine: init function FOUND in bashlet '$bashlet_file_path', invoking init()."
            init
        else
            Log "INFO" "BashletEngine: init function NOT FOUND in bashlet '$bashlet_file_path', skipping init."
        fi

    fi
 
}

exportVariablesForSubProcessesAsBase64() {

    # Export the Bashlet annotation metadata JSON as a Base64 encoded string
    # so that it can be safely passed through socat into child Bash processes.

    local bashlet_annotation_metadata_base64
    bashlet_annotation_metadata_base64="$(printf '%s' "$BASHLET_ANNOTATION_METADATA" | base64 -w 0)"
    export BASHLET_ANNOTATION_METADATA_BASE64="$bashlet_annotation_metadata_base64"

    # Export the route-to-bashlet associative array by serializing the entire
    # declare statement. This allows the array to be reconstructed later via eval.

    local route_path_to_bashlet_path_declaration_base64
    route_path_to_bashlet_path_declaration_base64="$(declare -p ROUTE_PATH_TO_BASHLET_PATH | base64 -w 0)"
    export ROUTE_PATH_TO_BASHLET_PATH_DECLARATION_BASE64="$route_path_to_bashlet_path_declaration_base64"
}

# undertakes the inverse operation of the immediately preceeding function: exportVariablesForSubProcessesAsBase64
# the requisite variables are first base64 DECODED before being exported as environment variables. This will
# be called by sub processes spawned by the Mocktail server (i.e. socat under the hood) to import the requisite
# variables for use in routing requests to the appropriate bashlet function.
importVariablesFromParentProcess() {

    # -----------------------------
    # Restore JSON metadata (safe string variable)
    # -----------------------------
    if [[ -z "${BASHLET_ANNOTATION_METADATA_FROM_PARENT_PROC:-}" ]]; then
        if [[ -n "${BASHLET_ANNOTATION_METADATA_BASE64:-}" ]]; then
            BASHLET_ANNOTATION_METADATA_FROM_PARENT_PROC="$(printf '%s' "$BASHLET_ANNOTATION_METADATA_BASE64" | base64 --decode)"
        fi
    fi

    # -----------------------------
    # Restore associative array (Bash object)
    # -----------------------------
    if [[ ${#ROUTE_PATH_TO_BASHLET_PATH_FROM_PARENT_PROC[@]} -eq 0 ]]; then

        if [[ -n "${ROUTE_PATH_TO_BASHLET_PATH_DECLARATION_BASE64:-}" ]]; then

            local __decoded_decl
            __decoded_decl="$(printf '%s' "$ROUTE_PATH_TO_BASHLET_PATH_DECLARATION_BASE64" | base64 --decode)"

            # Debug: show the decoded declare (preview) and non-printables, then syntax-check it
            #echo "BashletEngine: Decoded declare (preview):" >&2
            #printf '%s\n' "$__decoded_decl" | sed -n '1,120p' >&2
            #echo "BashletEngine: Decoded declare (show non-printables):" >&2
            #printf '%s' "$__decoded_decl" | sed -n '1,120p' | sed -n l >&2

            #if ! bash -n -c "$__decoded_decl" 2>/dev/null; then
            #    echo "BashletEngine: decoded declare failed 'bash -n' check" >&2
            #    echo "BashletEngine: dumping full decoded declare for debugging:" >&2
            #    printf '%s\n' "$__decoded_decl" >&2
            #fi

            # Attempt to eval the declare (creates ROUTE_PATH_TO_BASHLET_PATH)
            if ! eval "$__decoded_decl" 2>/dev/null; then
                Log "ERROR" "BashletEngine: eval of decoded declare failed; attempting fallback parse"
            fi

            # Create a usable associative copy named ROUTE_PATH_TO_BASHLET_PATH_FROM_PARENT_PROC
            declare -g -A ROUTE_PATH_TO_BASHLET_PATH_FROM_PARENT_PROC=()

            if declare -p ROUTE_PATH_TO_BASHLET_PATH >/dev/null 2>&1; then
                local __k
                for __k in "${!ROUTE_PATH_TO_BASHLET_PATH[@]}"; do
                    ROUTE_PATH_TO_BASHLET_PATH_FROM_PARENT_PROC["$__k"]="${ROUTE_PATH_TO_BASHLET_PATH[$__k]}"
                done
            fi

            # Keep raw declaration string available under the legacy name too
            export ROUTE_PATH_TO_BASHLET_PATH_FROM_PARENT_PROC_DECLARATION="$__decoded_decl"
        fi
    fi
}