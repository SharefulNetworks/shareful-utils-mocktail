StatusMsgForCode() {

    local status_code="$1"

    case "$status_code" in
    100) printf "Continue" ;;
    101) printf "Switching Protocols" ;;
    102) printf "Processing" ;;
    103) printf "Early Hints" ;;

    200) printf "OK" ;;
    201) printf "Created" ;;
    202) printf "Accepted" ;;
    203) printf "Non-Authoritative Information" ;;
    204) printf "No Content" ;;
    205) printf "Reset Content" ;;
    206) printf "Partial Content" ;;
    207) printf "Multi-Status" ;;
    208) printf "Already Reported" ;;
    226) printf "IM Used" ;;

    300) printf "Multiple Choices" ;;
    301) printf "Moved Permanently" ;;
    302) printf "Found" ;;
    303) printf "See Other" ;;
