#!/usr/bin/env bash

# source the config helpers so Log can resolve the configured log level.
source "${SCRIPT_DIR}/res/handlers/internal/utils/config-utils"

Log "DEBUG" "mime-utils: Loaded MIME type utility functions."

declare -A MIME_TYPES=(
    [html]="text/html"
    [htm]="text/html"
    [css]="text/css"
    [js]="application/javascript"
    [json]="application/json"
    [map]="application/json"
    [txt]="text/plain"
    [xml]="application/xml"

    [jpg]="image/jpeg"
    [jpeg]="image/jpeg"
    [png]="image/png"
    [gif]="image/gif"
    [svg]="image/svg+xml"
    [webp]="image/webp"
    [ico]="image/x-icon"

    [mp3]="audio/mpeg"
    [wav]="audio/wav"
    [ogg]="audio/ogg"

    [mp4]="video/mp4"
    [webm]="video/webm"

    [pdf]="application/pdf"
    [zip]="application/zip"
)



getMimeType() {
    local filename="$1"
    local ext="${filename##*.}"

    ext="${ext,,}" # lowercase (Bash 4+)

    echo "${MIME_TYPES[$ext]:-application/octet-stream}"
}