# provided with a URL encoded string, this function will decode it and return the resultant decoded string.
UrlDecode() {
    local encoded="$1"
    local decoded
    decoded=$(printf '%b' "${encoded//%/\\x}")
    echo "$decoded"
}

# provided with a string, this function will URL encode it and return the resultant encoded string.
UrlEncode(){
  local value="$1"
  local encoded
  encoded=$(jq -nr --arg v "$value" '$v|@uri')
  echo "$encoded"
}

