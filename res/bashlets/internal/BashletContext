}

DeleteBashletResponseCookie() {
    local -n responseObject="$1"
    local cookieName="$2"

    responseObject="$(jq --arg cookieName "$cookieName" 'del(.cookies[] | select(.name == $cookieName))' <<< "$responseObject")"
}

ExpireBashletResponseCookie() {
    local -n responseObject="$1"
    local cookieName="$2"

    # Set the cookie's expiration date to a past date to expire it.
    # If the response does not already contain a matching cookie, append a deletion cookie instead.
    responseObject="$(jq --arg cookieName "$cookieName" '
      .cookies //= []
      | if any(.cookies[]?; .name == $cookieName) then
          (.cookies[] | select(.name == $cookieName) | .expires) = "Thu, 01 Jan 1970 00:00:00 GMT"
        else
          .cookies += [{name: $cookieName, value: "", path: "/", expires: "Thu, 01 Jan 1970 00:00:00 GMT"}]
        end
    ' <<< "$responseObject")"
}

# Generates an admin session token, which is a JSON object containing a timestamp, a random salt value and a token signature.
GenerateAuthSessionToken(){
    local userPassphrase="$1"

    # build up a session token signature using the user passphrase, current timestamp and a random salt value.
    local timestamp
    timestamp=$(getTimestamp)
    local randomSalt
    randomSalt=$(openssl rand -hex 16)
    local sessionTokenSignature
    sessionTokenSignature=$(echo -n "${userPassphrase}${timestamp}${randomSalt}" | openssl dgst -sha512 | awk '{print $2}')

    # utilise JQ to create the session token JSON object, which will be returned to the caller. 
    # critically we omit the passphrase thereby making it almost imposible for an attacker to spoof a valid
    # session token by simply recreating the signature, as to do so they would need to know/brute force the 512-bit passphrase,
    # used to generate it... :) 
    jq -nc --arg tokenSignature "$sessionTokenSignature" --arg timestamp "$timestamp" --arg randSalt "$randomSalt" \
        '{
            timestamp: $timestamp,
            randSalt: $randSalt,
            tokenSignature: $tokenSignature,
        }'    
    
}

# Check the validity of the provided session token, by re-generating the expected token signature 
# using a secret (i.e. the user passphrase), timestamp and random salt, and comparing it with the 
# provided token signature.
CheckAuthSessionToken() {
    local sessionToken="$1"
    local userPassphrase="$2"

    # extract the timestamp, random salt and token signature from the session token JSON object.
    local timestamp
    timestamp=$(jq -r '.timestamp' <<< "$sessionToken")
    local randomSalt
    randomSalt=$(jq -r '.randSalt' <<< "$sessionToken")
    local tokenSignature
    tokenSignature=$(jq -r '.tokenSignature' <<< "$sessionToken")

    # first check if the token hss expired, by comparing the current timestamp with the timestamp in the session token.
    local currentTimestamp
    currentTimestamp=$(getTimestamp)
    local tokentimestampDelta
    tokentimestampDelta=$(computeTimestampDelta "$timestamp" "$currentTimestamp")

    # check if the token has expired based on the configured expiration time.
    # we multiply the expiration time in minutes by 60 to convert it to seconds, as the timestamp is in seconds.
    if [[ $tokentimestampDelta -gt $((AUTH_TOKEN_EXPIRATION_MINUTES * 60)) ]]; then
        return 1  # invalid - token has expired
    fi

    # providing the token has not expired, we proceed to validate the token signature.
    # re-generate the expected token signature using the provided timestamp and random salt plus 
    # the secret (i.e. the user passphrase) and compare it with the provided token signature.
    local expectedTokenSignature
    expectedTokenSignature=$(echo -n "${userPassphrase}${timestamp}${randomSalt}" | openssl dgst -sha512 | awk '{print $2}')

    # compare the provided token signature with the expected token signature.
    if [[ "$tokenSignature" == "$expectedTokenSignature" ]]; then
        return 0  # valid
    else
        return 1  # invalid
    fi

}




