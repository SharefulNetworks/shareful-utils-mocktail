#!/bin/bash


# ----------------------------------------------------------------------------------------------------------------
# Name:  ExampleBashlet 
# Author Giles Thompson
# Date:  21/06/2026
#
# Description:    
# An example Bashlet implementation that demonstrates how to configure route handlers for different HTTP
# methods (GET, POST, PUT, HEAD) how to parse the request body and construct a response. This should 
# serve as a reference for users creating their own Bashlets to handle specific API endpoints and 
# implement custom logic as needed.
#----------------------------------------------------------------------------------------------------------------


# IMPORTANT: first and foremost source the BashletContext, it supplies helper functions to support parsing of the incoming request object and constructing the response object.
source "$SCRIPT_DIR/res/bashlets/internal/BashletContext"



# Tests standard GET route handling using mock profiles endpoint. Typically a GET request at a 
# resource endpoint is used to retrieve a list of resources, in this case a list of user profiles.
# @route method=get path=/api/profiles
viewProfiles(){
    request="$1"
    response="$2"

    echo "ExampleBashlet: inside viewProfiles..." >&2


    # parse body from the request, for GET method, we expect it to be empty
    requestBody="$(ParseBashletRequestBody "$request")"
    echo "THE RECEIVED REQUEST BODY: $requestBody" >&2

    # build a mock response body to simulate list of user profiles...

    # first mock  user profile 1...
    userProfile1="{}"
    userProfile1="$(SetJSONString "$userProfile1" '.guid' 'AB36C78D87A886E868F686F86F86842A32424B24AAA42A4A')"
    userProfile1="$(SetJSONField  "$userProfile1" '.firstName' 'Giles')"
    userProfile1="$(SetJSONField  "$userProfile1" '.surname' 'Thompson')"
    userProfile1="$(SetJSONField  "$userProfile1" '.age' 35)"
    userProfile1Address="[]" # create array to hold addresses for user profile 1
    userProfile1Address="$(AppendJSONArrayItem "$userProfile1Address" '{"streetNumber": 25, "streetname": "Marton Avenue", "area": "Wythenshawe", "city": "Manchester", "county": "Lancashire", "postcode": "W145RE"}')"
    userProfile1Address="$(AppendJSONArrayItem "$userProfile1Address" '{"streetNumber": 57, "streetname": "Cronwell Street", "area": "Gorton", "city": "Manchester", "county": "Lancashire", "postcode": "M184RT"}')"
    userProfile1="$(SetJSONField "$userProfile1" '.addresses' "$userProfile1Address")" # append addresses array to user profile 1

    # then mock user profile 2..
    userProfile2="{}"
    userProfile2="$(SetJSONString "$userProfile2" '.guid' 'B36C78D87A886E868F686F86F86842A32424B24AAA42A4B')"
    userProfile2="$(SetJSONField  "$userProfile2" '.firstName' 'John')"
    userProfile2="$(SetJSONField  "$userProfile2" '.surname' 'Doe')"
    userProfile2="$(SetJSONField  "$userProfile2" '.age' 28)"

    # create the top-level profiles array and add the mock user profiles to it...
    userProfiles="[]"
    userProfiles="$(AppendJSONArrayItem "$userProfiles" "$userProfile1")"
    userProfiles="$(AppendJSONArrayItem "$userProfiles" "$userProfile2")"


    # finally set the response body to the mock user profiles array, this will signal the BashletEngine
    # to return the set response to the client.
    SetBashletResponseBody "$response" "$userProfiles"

    # DelegateRequest "/sys/ui/auth-login.html" "$METHOD" "$PROTOCOL" "$userProfiles"
}

# Tests standard POST route handling using mock profiles endpoint. Typically a POST request at a 
# resource endpoint is used to create a new resource, in this case a new user profile.
# @route method=post path=/api/profiles
createUserProfile(){
    request="$1"
    response="$2"

    echo "ExampleBashlet: inside createUserProfile..." >&2

  

    # parse body from the request, for the purpose of the test the body is expected to take the following form:
    #{
    #"guid": "AB36C78D87A886E868F686F86F86842A32424B24AAA42A4A", 
    #"firstName": "Giles", 
    #"surnname": "Thompson", 
    #"age": 35, 
    #"addresses": [
    #    {
    #     "streetNumber": 25,
    #     "streetname": "Marton Avenue",
    #     "area": "Wythenshawe",
    #     "city": "Manchester",
    #     "county": "Lancashire",
    #     "postcode": "W145RE"
    #    },
    #
    #    { 
    #      "streetNumber": 57,
    #      "streetname": "Cronwell Street",
    #      "area": "Gorton",
    #      "city": "Manchester",
    #      "county": "Lancashire",
    #      "postcode": "M184RT"
    #    }
    #
    #    ]
    #}


    # parse the body from the received request.
    requestBody="$(ParseBashletRequestBody "$request")"
    echo "THE RECEIVED REQUEST BODY: $requestBody" >&2

    # next parse specifc fields from the request body, we'll parse one top-level field
    # and a nested field in the  addresses array. In a real service implementation
    # the parsed fields would be used to create a new user profile in a database or other data store.

    # first the top-level guid field, which is a string.
    guid="$(ParseJSONField "$requestBody" '.guid')"
    echo "THE PARSED GUID FIELD: $guid" >&2

    # next the nested streetname field from the first address object in the addresses array.
    streetname="$(ParseJSONField "$requestBody" '.addresses[0].streetname')"
    echo "THE PARSED STREETNAME FIELD: $streetname" >&2

    # build up a mock response to indicate that the profile was created successfully.
    successResponseBody="{}"
    successResponseBody="$(SetJSONString "$successResponseBody" '.status' 'success')"
    successResponseBody="$(SetJSONString "$successResponseBody" '.message' 'profile created')"
    successResponseBody="$(SetJSONString "$successResponseBody" '.guid' $guid)"
    successResponseBody="$(SetJSONString "$successResponseBody" '.endpoint' '/api/profiles')"
    successResponseBody="$(SetJSONString "$successResponseBody" '.method' 'POST')"


    # finally set the response body to indicate that the profile was created successfully, this will signal the BashletEngine
    # to return the set response to the client.
    SetBashletResponseBody "$response" "$successResponseBody"



}

# Tests standard PUT route handling using mock profiles endpoint. Typically a PUT request at a
# resource endpoint is used to update an existing resource, in this case an existing user profile.
# @route method=put path=/api/profiles
updateUserProfile(){
    request="$1"
    response="$2"

    echo "ExampleBashlet: inside updateUserProfile..." >&2


    # parse body from the request, see the POST method for the expected body format.
    requestBody="$(ParseBashletRequestBody "$request")"
    echo "THE RECEIVED REQUEST BODY: $requestBody" >&2

    # next parse specifc fields from the request body, we'll parse one top-level field
    # and a nested field from  the  addresses array. In a real service implementation
    # the parsed fields would be used to update an existing user profile in a database or other data store.

    # first the top-level guid field, which is a string.
    guid="$(ParseJSONField "$requestBody" '.guid')"
    echo "THE PARSED GUID FIELD: $guid" >&2

    # Demonstrates the parsing of a nested array field:
    # Obtain the addresses array and iterate over each address object, parsing each field as we go.
    # for each object we should be able to call ParseJSONField with the appropriate path to extract the fields we need.
    while IFS= read -r address; do
     streetNumber="$(ParseJSONField "$address" '.streetNumber')"
     streetname="$(ParseJSONField "$address" '.streetname')"
     area="$(ParseJSONField "$address" '.area')"
     city="$(ParseJSONField "$address" '.city')"
     county="$(ParseJSONField "$address" '.county')"
     postcode="$(ParseJSONField "$address" '.postcode')"
 
     echo "Parsed Address: $streetNumber, $streetname, $area, $city, $county, $postcode" >&2
    done < <(ParseJSONField "$requestBody" '.addresses[]')

    successResponseBody="{}"
    successResponseBody="$(SetJSONString "$successResponseBody" '.status' 'success')"
    successResponseBody="$(SetJSONString "$successResponseBody" '.message' 'profile updated')"
    successResponseBody="$(SetJSONString "$successResponseBody" '.guid' $guid)"
    successResponseBody="$(SetJSONString "$successResponseBody" '.endpoint' '/api/profiles')"
    successResponseBody="$(SetJSONString "$successResponseBody" '.method' 'PUT')"


    #update the response body to indicate that the profile was updated successfully, 200 is assigned by default.
    SetBashletResponseBody "$response" "$successResponseBody"
    
    # here we test forwarding the request rather than sending a direct response. The call to SetBashletResponseBody 
    # above will be ignored by the BashletEngine, as the forwarding of a request will always take preedence.
    ForwardBashletRequest "/sys/ui/auth-login.html"


}

# @route method=head path=/api/profiles
viewProfilesHead(){
    request="$1"
    response="$2"

    echo "ExampleBashlet: inside viewProfilesHead..." >&2

    #update the response body to indicate that the login was successful, 200 is assigned by default.
    SetBashletResponseBody "$response" '{"status": "success", "message": "login successful", "endpoint": "/api/login", "method": "HEAD"}'

    echo "THE RECEIVED REQUEST OBJECT: $request" >&2
  

}


# This alternative viewProfiles function demonstrates the correct set up/definition of handler function
# with the exception of the fact that no request body is set. Where this is the case (as it might where a new handler is
# being developed) the BashletEngine will automatically set a default response body to be returned to the client.
# @route method=get path=/api/profiles/2
viewProfiles2(){

    request="$1"
    response="$2"

    echo "ExampleBashlet: inside viewProfiles2..." >&2

}

# This alternative createProfiles function demonstrates the correct set up/definition of handler function
# that returns an error response to the client. The builtin SendErrorResponse utility function  
# makes this relatively straight forward process.
# @route method=post path=/api/profiles/2
createProfiles2(){

    request="$1"
    response="$2"

    echo "ExampleBashlet: inside createProfiles2..." >&2

    # for the purposes of this example we will assume that the user has failed to provide a requisite "id" query string parameter
    # and we will return a 400 Bad Request error response to the client....

    # 1) attempt to parse the "id" query string parameter from the request object, if it is not present we will return a 400 Bad Request error response to the client.
    id="$(ParseBashletRequestQueryStringParam "$request" "id")"

    # 2) if the id parameter is not present we directly return an error response.
    if [[ -z $id ]]; then
        
        echo "ExampleBashlet: missing required query string parameter 'id', returning 400 Bad Request error response to client..." >&2
        SendErrorResponse "400" "Bad Request - Missing required query string parameter 'id'" "json"
       
     fi


}
