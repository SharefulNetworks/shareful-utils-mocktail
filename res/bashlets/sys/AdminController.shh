#!/bin/bash


# The Mocktail Servers main AdminController bashlet, which is responsible for handling system-level requests such as login, logout, 
# configuration updates and other system-related operations.

# import/source the BashletContext helper functions to support parsing of the incoming request object and constructing the response object.
source "$SCRIPT_DIR/res/bashlets/internal/BashletContext"

# import/source the config-utils helper functions to support reading and writing to the main server configuration JSON file.
source "$SCRIPT_DIR/res/utils/config-utils"



# Attempts to sign user in as a System Administrator using the specified credentials.
# @route method=post path=/doSignin
doSignin(){
    request="$1"
    response="$2"

    echo "AdminController: inside doSignin..." >&2

    # 0) PREAMBLE: Ensure we have loaded in the data required to undertake the signin process.

    # attempt to obtain the stored passphrase from the config file, where this fails we will reject 
    # the login attempt and return an error to the user.
    storedPassphrase="$(GetStoredPassphraseFromConfig)"
    if [ -z "$storedPassphrase" ]; then
        echo "AdminController: No stored auth passphrase found in config file, login attempt rejected." >&2

        local err_status_code=403
        local err_content="Forbidden - No stored auth passphrase found in config file, login attempt rejected. <a href='/sys/signup'><u><b>Please create an System Admin account</b></u></a>,before attempting to signin."
        SendBashletErrorResponse "$err_status_code" "$err_content" "$request"
        return 1
    fi


    # parse the any provided redirect URL from the request query parameters, where the login is successful
    # we will redirect the user to this URL, otherwise we will redirect the user back to the signin page
    # and include the provided redirect URL as a query parameter so that the user can be redirected to the 
    # intended page after any subsequent successful login. Where no success redirect URL is provided we 
    # will default to the main server dashboard ("/sys/admin/dashboard").
    successredirectURL="$(ParseBashletRequestQueryStringParam "$request" 'redirect')"
    if [ -z "$successredirectURL" ]; then
        successredirectURL="/sys/admin/dashboard"
    fi
    successredirectURL="$(UrlDecode "$successredirectURL")"
   
    # Prerequisites data loaded, we may now begin the signin process...................






    # 1 )IF AN AUTH COOKIE ALREADY EXISTS: and is valid then we may short-circuit the login process and redirect user
    # to the server home page.
    authCookie="$(getAuthCookieFromRequest "$request")"
    if [[ -n "$authCookie" ]]; then
        if CheckAuthSessionToken "$authCookie" "$storedPassphrase"; then
            
            echo "AdminController: user is already logged in to a valid session, redirecting to: home" >&2
            
            # redirect user to the provided "signin success" url.
            DispatchBashletRedirectResponse "$successredirectURL" "$response"
            return 1
        fi
    fi





    #2) OTHERWISE: We accept the authentication credentials from the user, compute the passphrase and validate it
    # against the stored passphrase we extracted from the config file above...w

    # parse the autentication credentials that were posted via the login form
    email="$(ParseFormDataParam "$request" 'email')"
    password="$(ParseFormDataParam "$request" 'password')"

    # produce a passphrase from the provided email and password.
    passphrase="$(ComputePassphrase "$email" "$password")"

  

    # Next, compare the computed passphrase with the stored passphrase, if they match then the login is successful, otherwise return an error to the user.
    if [ "$passphrase" == "$storedPassphrase" ]; then
        echo "AdminController: login successful, redirecting to: $successredirectURL" >&2

        # generate session token for the user, which is a JSON object containing a timestamp, a random salt value and a token signature.
        sessionToken="$(GenerateAuthSessionToken "$passphrase")"

        # call into our helper function to set the auth cookie in the response object, complete
        # with the session token we generated in the preceding step.
        setAuthCookieInResponse "$response" "$sessionToken"

        # redirect user to the provided "signin success" url.
        DispatchBashletRedirectResponse "$successredirectURL" "$response"
    else
        echo "AdminController: login failed - invalid credentials." >&2

       
        # prep error message to be set back to the client as a query parameter in the redirect URL, so that the login page can display the error message to the user.
        local err_message="Unauthorized - Invalid credentials provided, login failed. Please try again."

        # full redirect url
        local signinPageRedirectURL="/sys/signin?errorMessage=$(UrlEncode "$err_message")&redirect=$(UrlEncode "$successredirectURL")"

        # redirect user back to the signin page with the error message and any provided redirect URL as query parameters.
        DispatchBashletRedirectResponse "$signinPageRedirectURL"
       
        return 1
    fi

   
   
}


# Attempts to sign up a new System Admin user, a single admin user is permitted, 
# thus if an existing admin user already exists the signup attempt will be rejected.
# @route method=post path=/doSignup
doSignup(){
    request="$1"
    response="$2"

    echo "AdminController: inside doSignup..." >&2

    # read current server configuration data from the JSON config file.
    configData="$(ReadServerJSONConfig)"
    if [[ -z "$configData" ]]; then
        echo "AdminController: failed to read server configuration data from config file." >&2

        local err_status_code=500
        local err_content="Internal Server Error - Failed to read server configuration data from config file (config.json). If the file exists its likely corrupted, please delete it and restart the server."
        SendBashletErrorResponse "$err_status_code" "$err_content" "$request"
        return 1
    fi

    # only a single admin signup is permitted thus if a passphrase already exists in the config file, 
    # we will reject any further signup attempts.
    existingPassphrase="$(ParseJSONConfigSecuritySetting "$configData" "Passphrase")"
    if [ -n "$existingPassphrase" ]; then
        echo "AdminController: signup attempt rejected - admin user already exists." >&2

        local err_status_code=403
        local err_content="Forbidden - An existing admin user already exists; only one admin user can be created. <a href='/sys/signin'><u><b>Please login to the existing account</b></u></a>, if you have forgotten your password please visit the password reset page. "
        SendBashletErrorResponse "$err_status_code" "$err_content" "$request"
        return 1
    fi

    # first and foremost parse the autentication credentials that were posted via the signup form
    # we do quite extensive input validation on the client-side and thus here we will assume that the input is 
    # valid and well-formed, for now.
    email="$(ParseFormDataParam "$request" 'email')"
    password="$(ParseFormDataParam "$request" 'password')"

    # compute a passphrase from the provided email and password.
    passphrase="$(ComputePassphrase "$email" "$password")"

    # store passphrase to the config file, we firstly load the current config, update the passphrase field in the SecuritySettings object, 
    # and then write the updated config back to the file.
    updatedConfigData="$(SetJSONConfigSecuritySetting "$configData" "Passphrase" "$passphrase")"

    # store email to the config file.
    updatedConfigData="$(SetJSONConfigSecuritySetting "$updatedConfigData" "Email" "$email")"

    if [[ -z "$updatedConfigData" ]]; then
        echo "AdminController: failed to update config data with new passphrase." >&2

        local err_status_code=500
        local err_content="Internal Server Error - Failed to update config data with the new passphrase."
        SendBashletErrorResponse "$err_status_code" "$err_content" "$request"
        return 1
    fi
    UpdateConfigFile "$updatedConfigData" # actually update the config file on disk.

   
    # if we have arrived here the signup was successful, we will redirect the user to the signin page with a query parameter 
    # indicating that the signup was successful and that they should login with their credentials....

    # prep the success info_message we will display to the user on the signin page, which will be passed as a query parameter in the redirect URL.
    local info_message="Congratulations! Your System Admin account has been created. Please login for the first time using your credentials."
    
    # full redirect url
    local signinPageRedirectURL="/sys/signin?infoMessage=$(UrlEncode "$info_message")"

    # redirect user back to the signin page with the info message as a query parameter.
    DispatchBashletRedirectResponse "$signinPageRedirectURL"
    return 0


}


# Signs admin user out by expiring the auth cookie in the response object which is ultimately sent back to the client.
# @route method=get path=/doSignout
doSignout(){
    request="$1"
    response="$2"

    echo "AdminController: inside doSignout..." >&2
 
    # firstly validate the user is actually logged in by checking for the presence of the auth cookie in the request, 
    # if it is not present we will return an error to the user.
    authCookie="$(getAuthCookieFromRequest "$request")"
    if [[ -z "$authCookie" ]]; then

        echo "AdminController: signout attempt rejected - user is not currently logged in." >&2

        local err_status_code=400
        local err_content="Bad Request - User is not currently logged in."
        SendBashletErrorResponse "$err_status_code" "$err_content" "$request"
        return 1
    fi

    # critically we expire the auth cookie in the response returned to the client, which effectively signs the user out of the system.
    expireAuthCookieInResponse "$response"

    # next we redirect to the sign in page with a success message indicating that the user has been signed out successfully.
    local success_message="You have been signed out successfully."
    local signinPageRedirectURL="/sys/signin?successMessage=$(UrlEncode "$success_message")"

    # redirect user back to the signin page with the success message.
    DispatchBashletRedirectResponse "$signinPageRedirectURL" "$response"
}


# Navigates to the main admin dashboard which is only accessible to authenticated users, hence the secure route attribute.
# @route method=get path=/dashboard secure=true
viewAdminDashboard(){
    request="$1"
    response="$2"

    echo "AdminController: inside viewAdminDashboard, forwarding to admin dashboard..." >&2

    ForwardBashletRequest "/sys/ui/mocktail-dashboard.html"

}






# ----------------API endpoint routes they return a JSON-based response, they are intended to be called from within the context of system UI pages---------------


# API endpoint to return server stats, such as current process count, uptime, last login time etc.
# @route method=get path=/api/serverstats
apiGetServerStats(){
    request="$1"
    response="$2"

    echo "AdminController: inside apiGetServerStats..." >&2

    # get the Mocktail server's process utilization history.
    local processUtilizationHistory="$(getServerProcessUtilizationStats)"

    # the max process limit is obtained from the environment variable MAX_PROCESSES, which is set in the root-handler.
    local maxProcessLimit="$MAX_PROCESSES"

    # get the admin account email from environment variable which is set when the server is started.
    local adminUserEmail="$ADMIN_USER_EMAIL"

    # the server uptime is obtained by computing the delta between the current time and the server start timestamp.
    local serverStartTimestamp="$SERVER_START_TIMESTAMP"
    local serverUptime=$(( $(date +%s) - serverStartTimestamp ))

    # now that we have the raw system stats build up a json object to return to the client.
    successResponseBody="{}"
    successResponseBody="$(SetJSONString "$successResponseBody" '.maxProcessLimit' "$maxProcessLimit")"
    successResponseBody="$(SetJSONString "$successResponseBody" '.adminUserEmail' "$adminUserEmail")"
    successResponseBody="$(SetJSONString "$successResponseBody" '.serverUptime' "$serverUptime")"
    successResponseBody="$(SetJSONField "$successResponseBody" '.processUtilizationHistory' "$processUtilizationHistory")"
    
    # set the response body to the JSON object we have built.
    SetBashletResponseBody "$response" "$successResponseBody"

}







# ---------------------------------------------private utlity/ helper funnctions-------------------------------------------

setAuthCookieInResponse() {
    local response="$1"
    local cookieValue="$2"
    local cookieName="$AUTH_TOKEN_COOKIE_NAME"


    SetCookieInBashletResponse "$response" "$cookieName" "$cookieValue" "path=/" "secure=true" "httpOnly=true" "sameSite=lax"

}

getAuthCookieFromRequest() {
    local request="$1"
    local cookieName="$AUTH_TOKEN_COOKIE_NAME"

    ac="$(GetCookieInBashletRequest "$request" "$cookieName")"
    echo "$ac"
}

expireAuthCookieInResponse() {
    local response="$1"
    local cookieName="$AUTH_TOKEN_COOKIE_NAME"

    ExpireBashletResponseCookie "$response" "$cookieName"
}

getServerProcessUtilizationStats(){
    
    # issue a call to the BashletContext helper method to pull the process utilization history from the 
    # JSON file that is updated by the process usage monitor.
    local processUtilizationHistory="$(GetServerProcessUtilizationHistory)"
    echo "$processUtilizationHistory"
    
}



