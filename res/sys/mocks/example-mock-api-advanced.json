{
  "Name": "Example Mock API (Advanced)",
  "Description": "Example that demonstrates the use of Mocktail Server to create a more advanced Mock API with endpoints that return static and dynamic JSON responses.",
  "Version": "1.0",
  "CollectionId": "x102",
  "Type":"System",
  "Endpoints": [
    {
      "Path": "/api/v1/profiles",
      "Method": "GET",
      "Response": {
        "StatusCode": 200,
        "Headers": {
          "Content-Type": "application/json"
        },
        "Body": [
          {
            "profileId": 1,
            "username": "JonnyDoe",
            "email": "john.doe@example.com"
          }
        ]
      }
    },
    {
      "Path": "/api/v1/profiles/{profileId}",
      "Method": "POST",
      "Response": {
        "Body": "Echo"
      }
    },
    {
      "Path": "/api/v1/profiles/{profileId}/settings",
      "Method": "GET",
      "EnableDynamicParamSubstitution": true,
      "Response": {
        "Body": {
          "ProfileId": 1,
          "Username": "JonnyDoe",
          "Email": "john.doe@example.com",
          "Enable2FA": true,
          "EnableMailNotifications": false,
          "EnableUserGeolocation": true
        }
      }
    },
    {
      "Path": "/api/v1/profiles/{profileId}/credential-servers",
      "Method": "GET",
      "Response": {
        "StatusCode": 302,
        "Body": [
          "http://mysite.com/credential-server-1",
          "http://mysite.com/credential-server-2",
          "http://mysite.com/credential-server-3",
          "http://mysite.com/credential-server-4",
          "http://mysite.com/credential-server-5"
        ]
      }
    }

  ]
}