# dispatches an error response to the client based on the provided error code, path, method and protocol. 
# The response will include a JSON body with details of the error.
dispatchErrorResponse(){
   local statusCode="$1"
   local content="$2"
   local contentType="$3"
   local acceptsHtml="$4"

   # if the client accepts HTML, we will return an HTML error page, otherwise we will return a JSON error response.
    if [[ "$acceptsHtml" == "true" ]]; then
        local errorPageContent="<html><head><title>Error $statusCode</title></head><body><h1>Error $statusCode</h1><p>$content</p></body></html>"
        dispatchResponse "$statusCode" "$errorPageContent" "text/html"
    else
       DispatchResponse "$statusCode" "$content" "$contentType"
    fi

   

}

dispatchSuccessResponse(){
    local content="$1"
    local contentType="$2"
    
     printf "HTTP/1.1 200 OK\r\n"
     printf "Content-Type: %s\r\n" "$contentType"
     printf "Content-Length: %s\r\n" "${#content}"
     printf "Connection: close\r\n"
     printf "\r\n"
     printf "%s" "$content"
}




dispatchFileResponse(){
  local file_path="$1"
  local contentType="$2"

  # Prefer stat for size, fallback to wc -c
  local size
  if ! size=$(stat -c%s "$file_path" 2>/dev/null); then
    size=$(wc -c <"$file_path" 2>/dev/null || echo 0)
  fi

  printf "HTTP/1.1 200 OK\r\n"
  printf "Content-Type: %s\r\n" "$contentType"
  printf "Content-Length: %s\r\n" "$size"
  printf "Connection: close\r\n"
  printf "\r\n"
  cat "$file_path"

}


stripPrefixFromPath() {
    local path="$1"
    local prefix="$2"

    if [[ "$path" == "$prefix" ]]; then
        echo ""
    elif [[ "$path" == "$prefix"/* ]]; then
        echo "${path#"$prefix"/}"
    else
        echo "$path"
    fi
}


# provided with a URL encoded string, this function will decode it and return the resultant decoded string.
urlDecode() {
    local encoded="$1"
    local decoded
    decoded=$(printf '%b' "${encoded//%/\\x}")
    echo "$decoded"
}

# provided with a string, this function will URL encode it and return the resultant encoded string.
urlEncode(){
  local value="$1"
  local encoded
  encoded=$(jq -nr --arg v "$value" '$v|@uri')
  echo "$encoded"
}



