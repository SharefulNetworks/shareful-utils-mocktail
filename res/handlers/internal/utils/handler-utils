# PUBLIC FUNCTION: reads and parses the request read from the socket into an array of headers and a body, taking care to handle the case where the 
# request may not have a body, and return the headers and body as separate variables.
ReadAndParseRequest(){ 

  local method path protocol
  local header
  local content_length=0
  local headers='{}'
  local body=''
  local query_raw
  local query_json='{}'
  local content_type #we store this as we may to do additional parsing of the body based on this value. e.g where its: "application/x-www-form-urlencoded" 
  local form_data_json='{}'
  local cookies_raw=''
  local cookies_json='{}'

  read -r -t 5 method path protocol || return 1

  # Extract the query string from the path (safe split)
  if [[ "$path" == *\?* ]]; then
    query_raw="${path#*\?}"
    path="${path%%\?*}"
  else
    query_raw=""
  fi

  echo "handler-utils: Received request>>>>: $method $path $protocol " >&2
  #echo "QUERY STRING IS: $query_string" >&2

  # parse headers into json objects of key value pairs, taking care to handle the case where the request may not have any headers, and return the headers as a json object.
  while IFS= read -r header; do
  
      header=${header%$'\r'} 
      [[ -z "$header" ]] && break 
      local name=${header%%:*}
      local value=${header#*: }

      # if the current header is "Content-Type" we store it in a variable for later use, 
      # as we may need to do additional parsing of the body based on this value. e.g where its: "application/x-www-form-urlencoded" 
      [[ $name == "Content-Type" ]] && content_type=$value

      # if the current header is "Cookie" we store it in a variable for later use, as we may need to do additional parsing of 
      # the cookies name value pairs  e.g where its: "session_id=abc123; path=/; secure; HttpOnly; SameSite=Strict"
      [[ $name == "Cookie" ]] && cookies_raw=$value

      headers=$(
          jq \
              --arg name "$name" \
              --arg value "$value" \
              '. + {($name): $value}' \
              <<< "$headers"
      ) 
      [[ $name == "Content-Length" ]] &&
          content_length=$value
  done

  if (( content_length > 0 )); then
      IFS= read -r -N "$content_length" body
  fi

  
  # similarly parse query string into json objects of key value pairs, taking care to handle the case where the request may not have any query parameters, and return the query string as a json object.
    if [[ -n "$query_raw" ]]; then
      IFS='&' read -ra query_params <<< "$query_raw"
      for param in "${query_params[@]}"; do
        local name=${param%%=*}
        local value=${param#*=}
        query_json=$(
          jq \
            --arg name "$name" \
            --arg value "$value" \
            '. + {($name): $value}' \
            <<< "$query_json"
        )
      done
    fi

  # if the request content-type header is equal to: "application/x-www-form-urlencoded" then the
  # body of the request will be a series of name-value pairs separated by the "&" character, 
  # we will parse these into a json object of key value pairs, taking care to handle the case where the request may not have any body parameters.
  if [[ "$content_type" == "application/x-www-form-urlencoded" && -n "$body" ]]; then
      IFS='&' read -ra body_params <<< "$body"
      local body_json='{}'
      for param in "${body_params[@]}"; do
        local name=${param%%=*}
        local value=${param#*=}
        body_json=$(
          jq \
            --arg name "$name" \
            --arg value "$(urlDecode "$value")" \
            '. + {($name): $value}' \
            <<< "$body_json"
        )
      done
      form_data_json="$body_json"
  fi

  #  next if one or more cookies have been provided in the request we parse each one into a json object of key value pairs, taking care to 
  # handle the case where the request may not have any cookies, and return the cookies as a json object.
  if [[ -n "$cookies_raw" ]]; then
      IFS=';' read -ra cookie_params <<< "$cookies_raw"
      for cookie in "${cookie_params[@]}"; do
        cookie="${cookie#${cookie%%[![:space:]]*}}"
        cookie="${cookie%${cookie##*[![:space:]]}}"
        [[ -z "$cookie" ]] && continue

        local name=${cookie%%=*}
        local value=${cookie#*=}

        cookies_json=$(
          jq \
            --arg name "$name" \
            --arg value "$value" \
            '. + {($name): $value}' \
            <<< "$cookies_json"
        )
      done
  fi

  jq -n \
      --arg method "$method" \
      --arg path "$path" \
      --arg protocol "$protocol" \
      --arg body "$body" \
      --argjson headers "$headers" \
      --argjson query_string "$query_json" \
      --argjson form_data "$form_data_json" \
      --argjson cookies "$cookies_json" \
      '{
          method: $method,
          path: $path,
          protocol: $protocol,
          headers: $headers,
          query_string: $query_string,
          body: $body,
          form_data: $form_data,
          cookies: $cookies
      }'

}

 

# PUBLIC FUNCTION: attempts to resolve the defined route associated with the specified path 
ResolveRouteFromPath() {

 local path="$1"
 local config_path="$2"
 local route_info

 echo "handler-utils: Resolving route for path: $path using configuration standby..." >&2

 # Use jq to select the longest matching wildcard route, then extract the
 # route type and handler script for sub-handler routes.
 route_info="$({
    jq -c --arg path "$path" '
      [.Routes[]
       | .Path as $route_path
       | select(
           ($route_path | rtrimstr("*") | rtrimstr("/")) as $prefix
           | (
               ($path == $prefix)
               or ($path | startswith($prefix + "/"))
               or ($path | startswith($prefix + "?"))
             )
         )
      ]
      | sort_by(.Path | length)
      | reverse
      | .[0] // empty
    ' "${config_path}"
  })"

 # where we have found a matching route return it.
 if [[ -n "$route_info" ]]; then
     echo "handler-utils: Successfully resolved route for path: $path" >&2
     echo "$route_info"
  else
        echo "handler-utils: No matching route found for path: $path" >&2
        echo "" # return empty string to indicate no route found 
 fi
   

}

# PUBLIC FUNCTION: handles the request according to the route Type defined in the route data provided as the first 
# parameter to this function. Where the specified route type is unsupported an appropriate error
# response will be generated and returned to the client.
HandleRequestAccordingToRoute() {
  echo "handler-utils: Handling request for path: $path according to resolved route..." >&2
  local route_info="$1"
  local path="$2"
  local method="$3"
  local protocol="$4"
  local request_json_object="$5"

  #parse the route type from the route info, then handle request according to it.
  route_type=$(parseRouteType "$route_info")
  case "$route_type" in
    "sub-handler")
        handleSubHandlerRouteRequest "$route_info" "$path" "$method" "$protocol" "$request_json_object"
        ;;
    "static")
        handleStaticRouteRequest "$route_info" "$path" "$method" "$protocol" "$request_json_object"
        ;;
    "bashlet")
        handleBashletRouteRequest "$route_info" "$path" "$method" "$protocol" "$request_json_object"
        ;;
    *)
        echo "root-handler: Unsupported route type: $route_type for path: $path, sending error response." >&2
        DispatchErrorResponse 500 "Unsupported route type: $route_type for path: $path" "application/json" "$path" "$method" "$request_json_object"
        echo "root-handler: Default response sent for path: $path, closing connection." >&2
        ;;
  esac

}


DispatchResponse(){

    local statusCode="$1"
    local content="$2"
    local contentType="$3"

    printf "HTTP/1.1 %s %s\r\n" "$statusCode" "$(StatusMsgForCode "$statusCode")"
    printf "Content-Type: %s\r\n" "$contentType"
    printf "Content-Length: %s\r\n" "${#content}"
    printf "Connection: close\r\n"
    printf "\r\n"
    printf "%s" "$content"

}

DispatchRedirectResponse() {
    local redirect_url="$1"
    local status_code=302
    local status_message="$(GetStatusMsgForCode $status_code)"
    local headers="{\"Location\": \"$redirect_url\"}"
    local content_type="text/html"
    local content="<html><body><p>$status_code $status_message</p><p>Redirecting to <a href=\"$redirect_url\">$redirect_url</a></p></body></html>"

    printf "HTTP/1.1 %s %s\r\n" "$status_code" "$status_message"
    printf "Content-Type: %s\r\n" "$content_type"
    printf "Content-Length: %s\r\n" "${#content}"
    printf "Connection: close\r\n"
    printf "Location: %s\r\n" "$redirect_url"
    printf "\r\n"
    printf "%s" "$content"
}


# PUBLIC FUNCTION: dispatches an error response to the client based on the provided error code, path, method and protocol. 
# The response will include a JSON body with details of the error.
DispatchErrorResponse(){

   local statusCode="$1"
   local content="$2"
   local contentType="$3"
   local path="$4"
   local method="$5"
   local fullRequestObject="$6"

    local statusMessage="$(GetStatusMsgForCode $statusCode)"
   
  
   # esnure that the status code begins with a 4 or 5 to indicate a client or server error respectively, 
   # if not we default to a 500 internal server error.
    if [[ ! "$statusCode" =~ ^[45] ]]; then
        echo "handler-utils: Invalid error status code: $statusCode, defaulting to 500 Internal Server Error." >&2
        statusCode=500
        content="Internal Server Error - An invalid error status code was provided. The path was: $path. The  method was: $method. The original error status code was: $1. The original error content was: $content"
    fi

   # if the client that initated the request accepts HTML, we will return an HTML error page, otherwise we will return a JSON error response.
   if reqAcceptsHtml "$fullRequestObject"; then
       DispatchRedirectResponse "/sys/ui/errors-dynamic.html?status=$statusCode&message=$statusMessage&content=$content | Request Path: $path Request Method: $method"
   else
       # delegate to the default dispatch response function.
       body='{"status":"'"$statusMessage"'","method":"'"$method"'","path":"'"$path"'","details":"'"$content"'"}'
       DispatchResponse "$statusCode" "$body" "$contentType"
   fi


}

# Genertes a SHA-512 hash of the provided input string and returns the hash value.
ToSha512() {
    local input="$1"
    echo -n "$input" | sha512sum
}


ComputePassphrase() {
    local email="$1"
    local password="$2"
    local passphrase
    passphrase="$(ToSha512 "$email-$password")"
    echo "$passphrase"
}


